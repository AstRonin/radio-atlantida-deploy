#!/usr/bin/env bash
# shellcheck disable=SC2016 # jq filters are single-quoted on purpose
# radioctl: the update tool of the Radio Atlantida production stack
# (deploy-init-plan.md D5 §7, docs/tech-design.md §9.2). It runs inside the
# radio-atlantida WSL distribution as the user radio; update.bat calls it
# through wsl.exe. It is the only way to change the production stack: it
# records in state.json what a rollback and a restore need.
#
#   radioctl [options] update [<backendTag> [<frontendTag>]]
#   radioctl [options] rollback
#   radioctl [options] restore [<dump>]
#   radioctl [options] maintenance
#   radioctl [options] cutover [--undo]
#   radioctl [options] first-run [--media-root <path>]
#   radioctl status
#   radioctl logs [<service>...]
#   radioctl compose <args>
#   radioctl [options] backup              (daily, radio-backup.timer)
#   radioctl [options] restore-drill [<dump>]  (monthly, radio-restore-drill.timer)
#   radioctl [options] network [--mode nat|mirrored]  (boot, radio-network.service)
#   radioctl boot-check                     (boot, radio-boot-check.service)
#
# Options: --dry-run, --yes, --no-wait, --no-fetch, -h/--help (see usage).
#
# Rules (plan §1.1): secrets are never printed or logged; .env is parsed,
# never sourced; every external command's output goes to the run log
# (logs/<command>-YYYY-MM-DDTHHMMSSZ.log), the console shows the steps and
# the result; destructive steps need a typed word (RESTORE, MAINTENANCE,
# CUTOVER), which --yes never answers.
#
# Test and dry-run switches (environment, never in .env):
#   RADIOCTL_ROOT             deploy directory (default: this script's ../)
#   COMPOSE_PROJECT_NAME      compose project (default: radio-atlantida)
#   RADIOCTL_BACKEND_IMAGE, RADIOCTL_FRONTEND_IMAGE
#                             image repositories (default: ghcr.io/astronin/...)
#   RADIOCTL_COMPOSE_OVERRIDE an extra compose file (a test registry)
#   RADIOCTL_HEALTH_TIMEOUT   backend health gate in seconds (default 90, min 60)
#   RADIOCTL_LOCK_WAIT        seconds to wait for state.lock (default 600)
#   RADIOCTL_FAKE_CLOCK       file holding the epoch seconds; sleeps advance it
#   RADIOCTL_HOST_ENV         host settings of setup-distro.sh (default
#                             /etc/radio-atlantida/host.env: RADIO_NETWORK_MODE)
#   RADIOCTL_NET_DEV          interface of the VM address in NAT mode (eth0)
#   RADIOCTL_NET_WAIT         seconds to wait for its IPv4 address (default 30)
#   RADIOCTL_BOOT_WAIT        boot check: seconds to wait (default 600)
#   RADIOCTL_UPTIME0          boot check: VM uptime in seconds at its start
#                             (default: /proc/uptime)
#   RADIOCTL_STREAM_OVERRIDE  JSON object merged over config/stream-defaults.json,
#                             the stream settings the first run proposes (a
#                             test Icecast in the dry run)

set -Eeuo pipefail
shopt -s inherit_errexit

ORIG_ARGS=("$@")
SELF=$(readlink -f "${BASH_SOURCE[0]}")
ROOT=${RADIOCTL_ROOT:-$(cd "$(dirname "$SELF")/.." && pwd)}

# shellcheck source=scripts/lib/contract.sh
source "$ROOT/scripts/lib/contract.sh"

PROJECT=${COMPOSE_PROJECT_NAME:-radio-atlantida}
BACKEND_IMAGE=${RADIOCTL_BACKEND_IMAGE:-ghcr.io/astronin/radio-atlantida-backend}
FRONTEND_IMAGE=${RADIOCTL_FRONTEND_IMAGE:-ghcr.io/astronin/radio-atlantida-frontend}
COMPOSE_OVERRIDE=${RADIOCTL_COMPOSE_OVERRIDE:-}
HEALTH_TIMEOUT=${RADIOCTL_HEALTH_TIMEOUT:-90}
((HEALTH_TIMEOUT >= 60)) || HEALTH_TIMEOUT=60
LOCK_WAIT=${RADIOCTL_LOCK_WAIT:-600}
API=http://127.0.0.1:8090

ENV_FILE=$ROOT/.env
RELEASE_FILE=$ROOT/release.env
STATE_FILE=$ROOT/state.json
LOCK_FILE=$ROOT/state.lock
RUNTIME_DIR=$ROOT/runtime
APPLIED_ENV=$RUNTIME_DIR/applied.env
TARGET_ENV=$RUNTIME_DIR/target.env
NETWORK_ENV=$RUNTIME_DIR/network.env
LOG_DIR=$ROOT/logs
SCRIPT_FILE=$ROOT/config/liquidsoap/radio.liq

# The stream output the first run proposes (plan 6.8, 11.14): a tracked
# file, so a moved server needs no code change. Afterwards the panel
# settings stream.* are the only source of truth; nothing here compares them
# with these values.
STREAM_DEFAULTS_FILE=$ROOT/config/stream-defaults.json
# Dry-run switch: a JSON object merged over the defaults, e.g. a test Icecast
# in the Mac dry run (D7 9.3).
if [[ -n ${RADIOCTL_STREAM_OVERRIDE:-} ]] &&
  ! jq -e 'type == "object"' <<<"$RADIOCTL_STREAM_OVERRIDE" >/dev/null 2>&1; then
  echo "ERROR: RADIOCTL_STREAM_OVERRIDE is not a JSON object" >&2
  exit 2
fi

DRY_RUN=false
YES=false
NO_WAIT=false
NO_FETCH=${RADIOCTL_NO_FETCH:-false}
CMD=
LOG_FILE=/dev/null
LOG_REL=
declare -A ENV=()

# ---------------------------------------------------------------------------
# Output and logging

exec 3>&1 4>&2 5>/dev/null

utc_now() { fmt_time UTC '%Y-%m-%dT%H:%M:%SZ' "$(now)"; }
utc_stamp() { fmt_time UTC '%Y-%m-%dT%H%M%SZ' "$(now)"; }

log() { printf '%s %s\n' "$(utc_now)" "$*" >&5; }
say() {
  printf '%s\n' "$*" >&3
  log "$*"
}
step() { say "==> $*"; }
warn() {
  printf 'WARNING: %s\n' "$*" >&3
  log "WARNING: $*"
}
die() {
  printf 'ERROR: %s\n' "$*" >&4
  log "ERROR: $*"
  exit 1
}

# logrun <command...>: runs it with its output in the run log.
#
# `docker compose exec` and `run` forward this script's stdin into the
# container even with -T, and so would swallow the operator's answers (piped
# or typed ahead); every exec and run that needs no input reads /dev/null.
logrun() {
  log "+ $*"
  "$@" >&5 2>&5
}

# mut <command...>: a command that changes something; printed, not run,
# with --dry-run.
mut() {
  if $DRY_RUN; then
    case $1 in
      dc | dct) say "    [dry-run] docker compose ${*:2}" ;;
      *) say "    [dry-run] $*" ;;
    esac
    return 0
  fi
  logrun "$@"
}

open_log() {
  mkdir -p "$LOG_DIR"
  local name
  name="$1-$(utc_stamp)"
  $DRY_RUN && name+=-dry-run
  LOG_FILE=$LOG_DIR/$name.log
  LOG_REL=logs/$name.log
  exec 5>>"$LOG_FILE"
  log "radioctl ${ORIG_ARGS[*]} (root $ROOT, project $PROJECT)"
}

on_error() {
  log "unexpected error (exit $1) at line $2: $3"
  printf 'ERROR: unexpected failure at line %s; see %s\n' "$2" "${LOG_REL:-the run log}" >&4
}
trap 'on_error $? $LINENO "$BASH_COMMAND"' ERR

# ---------------------------------------------------------------------------
# Clock (a file in tests, so waits are instant)

now() {
  if [[ -n ${RADIOCTL_FAKE_CLOCK:-} ]]; then
    printf '%s' "$(<"$RADIOCTL_FAKE_CLOCK")"
  else
    printf '%(%s)T' -1
  fi
}

sleep_s() {
  if [[ -n ${RADIOCTL_FAKE_CLOCK:-} ]]; then
    printf '%s' "$(($(now) + $1))" >"$RADIOCTL_FAKE_CLOCK"
  else
    sleep "$1"
  fi
}

# fmt_time <tz> <format> <epoch>
fmt_time() {
  (
    export TZ=$1
    printf "%($2)T" "$3"
  )
}

# ---------------------------------------------------------------------------
# Files: .env, release.env, runtime/*.env (parsed, never sourced)

# read_kv <file> <assoc name>: KEY=VALUE lines; # comments and blank lines
# skipped; one level of matching quotes removed.
read_kv() {
  local -n _kv=$2
  local line key val
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%$'\r'}
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    [[ $line =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
    key=${BASH_REMATCH[2]}
    val=${BASH_REMATCH[3]}
    if [[ $val =~ ^\'(.*)\'$ || $val =~ ^\"(.*)\"$ ]]; then
      val=${BASH_REMATCH[1]}
    fi
    _kv["$key"]=$val
  done <"$1"
}

envv() { printf '%s' "${ENV[$1]:-${2:-}}"; }

load_env() {
  [[ -f $ENV_FILE ]] || return 1
  ENV=()
  read_kv "$ENV_FILE" ENV
}

monitoring_enabled() { [[ $(envv MONITORING_ENABLED true) == true ]]; }

REQUIRED_VARS=(GHCR_USER GHCR_READ_TOKEN MEDIA_ROOT PLAYOUT_JOURNAL_ROOT BACKUP_ROOT
  POSTGRES_USER POSTGRES_PASSWORD POSTGRES_DB ICECAST_SOURCE_PASSWORD
  LIQUIDSOAP_CONTROL_PASSWORD)
MONITORING_VARS=(GRAFANA_ADMIN_PASSWORD GRAFANA_DB_PASSWORD)

check_env_vars() {
  local v missing=()
  for v in "${REQUIRED_VARS[@]}"; do
    [[ -n ${ENV[$v]:-} ]] || missing+=("$v")
  done
  if monitoring_enabled; then
    for v in "${MONITORING_VARS[@]}"; do
      [[ -n ${ENV[$v]:-} ]] || missing+=("$v")
    done
  fi
  ((${#missing[@]} == 0)) || die ".env lacks: ${missing[*]}"
}

# app_env_body <btag> <bdigest> <ftag> <fdigest>: the KEY=VALUE lines of an
# app env file: the release, and the values derived from .env (GRAFANA_URL).
app_env_body() {
  local grafana_url=
  if monitoring_enabled; then
    grafana_url=http://127.0.0.1:$(envv GRAFANA_PORT 3000)
  fi
  cat <<EOF
BACKEND_TAG=$1
BACKEND_DIGEST=$2
FRONTEND_TAG=$3
FRONTEND_DIGEST=$4
GRAFANA_URL=$grafana_url
EOF
}

# write_app_env <file> <btag> <bdigest> <ftag> <fdigest>
write_app_env() {
  if $DRY_RUN; then
    say "    [dry-run] write ${1#"$ROOT"/}: backend $2, frontend $4"
    return 0
  fi
  mkdir -p "$RUNTIME_DIR"
  {
    printf '# Written by bin/radioctl %s; the release compose runs with.\n' "$(utc_now)"
    app_env_body "$2" "$3" "$4" "$5"
  } >"$1.tmp"
  mv "$1.tmp" "$1"
}

# ---------------------------------------------------------------------------
# state.json

state_init() {
  [[ -f $STATE_FILE ]] && return 0
  $DRY_RUN && return 0
  printf '%s\n' '{"schema":1,"current":null,"previous":null,"applied":{},"pending_maintenance":[],"history":[]}' >"$STATE_FILE"
}

# state_get <jq filter> [jq args...]: prints the value (raw).
state_get() {
  [[ -f $STATE_FILE ]] || return 0
  jq -r "$@" "$STATE_FILE"
}

# state_set <jq filter> [jq args...]: rewrites state.json atomically.
state_set() {
  if $DRY_RUN; then
    log "[dry-run] state.json: $1"
    return 0
  fi
  state_init
  local tmp=$STATE_FILE.tmp
  jq "$@" "$STATE_FILE" >"$tmp"
  mv "$tmp" "$STATE_FILE"
}

installed() {
  [[ -f $STATE_FILE ]] && [[ -n $(state_get '.current.backend_tag // empty') ]]
}

cutover_done() { [[ -n $(state_get '.cutover_utc // empty') ]]; }

# ---------------------------------------------------------------------------
# Lock

take_lock() {
  if [[ ${RADIOCTL_LOCK_HELD:-} == 1 ]]; then
    return 0
  fi
  exec 9>>"$LOCK_FILE"
  if flock -n 9; then
    export RADIOCTL_LOCK_HELD=1
    return 0
  fi
  if ((LOCK_WAIT > 0)); then
    say "Another radioctl (an update or the backup) is running; waiting up to ${LOCK_WAIT}s."
    if flock -w "$LOCK_WAIT" 9; then
      export RADIOCTL_LOCK_HELD=1
      return 0
    fi
  fi
  die "another radioctl is running (state.lock); try again later"
}

# ---------------------------------------------------------------------------
# Versions

is_semver() { [[ $1 =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; }

# ver_cmp <a> <b>: prints -1, 0, or 1.
ver_cmp() {
  local -a a b
  local i
  IFS=. read -r -a a <<<"$1"
  IFS=. read -r -a b <<<"$2"
  for i in 0 1 2; do
    if ((a[i] < b[i])); then
      echo -1
      return
    elif ((a[i] > b[i])); then
      echo 1
      return
    fi
  done
  echo 0
}
ver_lt() { [[ $(ver_cmp "$1" "$2") == -1 ]]; }
ver_gt() { [[ $(ver_cmp "$1" "$2") == 1 ]]; }
major_minor() { printf '%s' "${1%.*}"; }

release_label() {
  if [[ $1 == "$2" ]]; then
    printf '%s' "$1"
  else
    printf 'backend %s, frontend %s' "$1" "$2"
  fi
}

# ---------------------------------------------------------------------------
# Docker and Compose

COMPOSE=()
# compose_args <app env file>
compose_args() {
  COMPOSE=(compose --project-directory "$ROOT" -f "$ROOT/docker-compose.yml")
  [[ -n $COMPOSE_OVERRIDE ]] && COMPOSE+=(-f "$COMPOSE_OVERRIDE")
  COMPOSE+=(--env-file "$ENV_FILE" --env-file "$1" --env-file "$NETWORK_ENV")
  if monitoring_enabled; then
    COMPOSE+=(--profile monitoring)
  fi
  return 0
}

# dc: compose with the running release (runtime/applied.env).
dc() {
  compose_args "$APPLIED_ENV"
  docker "${COMPOSE[@]}" "$@"
}

# dct: compose with the target release (runtime/target.env).
dct() {
  compose_args "$TARGET_ENV"
  docker "${COMPOSE[@]}" "$@"
}

db_sql() {
  dc exec -T db psql -U "$(envv POSTGRES_USER)" -d "$(envv POSTGRES_DB)" -v ON_ERROR_STOP=1 -tAc "$1" </dev/null 2>&5
}

# api_get <path>: the body of GET <path> on the backend, through its own
# curl (the backend publishes no port).
api_get() {
  dc exec -T backend curl -fsS --max-time 5 "$API$1" </dev/null 2>&5
}

# api_patch_settings <json values object>
api_patch_settings() {
  jq -c '{values: .}' <<<"$1" |
    dc exec -T backend curl -fsS --max-time 15 -X PATCH -H 'Content-Type: application/json' \
      --data-binary @- "$API/api/settings" >&5 2>&5
}

# setting <key>: the value of a backend setting (JSON-encoded if not a string).
setting() {
  local body
  body=$(api_get /api/settings) || return 1
  jq -r --arg k "$1" '.items[] | select(.key == $k) | .value | if type == "string" then . else tojson end' <<<"$body"
}

# ---------------------------------------------------------------------------
# Stream output: the panel settings stream.* (design §8.8). The server may
# move; radioctl never assumes one.

# stream_settings: the current stream.* settings as one JSON object.
stream_settings() {
  local body
  body=$(api_get /api/settings) || return 1
  jq -ce '[.items[] | select(.key | startswith("stream.")) | {(.key): .value}] | add // {}' <<<"$body"
}

# stream_defaults: config/stream-defaults.json with RADIOCTL_STREAM_OVERRIDE
# merged over it (the values the first run proposes).
stream_defaults() {
  local d
  d=$(jq -ce 'if type == "object" then . else error("not an object") end' "$STREAM_DEFAULTS_FILE" 2>&5) || return 1
  if [[ -n ${RADIOCTL_STREAM_OVERRIDE:-} ]]; then
    d=$(jq -c --argjson o "$RADIOCTL_STREAM_OVERRIDE" '. + $o' <<<"$d")
  fi
  printf '%s' "$d"
}

# stream_base <settings json>: scheme://host:port of the Icecast server.
stream_base() {
  jq -r '"\(if ."stream.icecast_tls" == true then "https" else "http" end)://"
    + (."stream.icecast_host" // "?" | tostring | if test(":") then "[\(.)]" else . end)
    + ":\(."stream.icecast_port" // "?")"' <<<"$1"
}

# stream_source_url <settings json>: where liquidsoap sends the stream. The
# listener URL may differ (another port, plain HTTP): the server's status
# page lists it as the mount's listenurl.
stream_source_url() { printf '%s%s' "$(stream_base "$1")" "$(jq -r '."stream.mount" // "?"' <<<"$1")"; }

# stream_show <settings json>: the output, one line per part.
stream_show() {
  local l
  while IFS= read -r l; do say "$l"; done < <(jq -r '
    "    server    \(."stream.icecast_host" // "(not set)"), port \(."stream.icecast_port" // "(not set)"), TLS \(if ."stream.icecast_tls" == true then "on" else "off" end)",
    "    mount     \(."stream.mount" // "(not set)")",
    "    format    \(."stream.codec" // "?"), \(."stream.bitrate_kbps" // "?") kbps, \(."stream.sample_rate_hz" // "?") Hz, \(."stream.channels" // "?") channel(s)"' <<<"$1")
}

# listen_hint <settings json>: what to listen to after a change.
listen_hint() {
  say "The source streams to $(stream_source_url "$1")."
  say "The listener URL (it may use another port or plain HTTP) is on the Icecast status page:"
  say "    $(stream_base "$1")/status-json.xsl (listenurl of $(jq -r '."stream.mount" // "?"' <<<"$1"))"
}

# The checks of the backend (internal/settings/definitions.go).
valid_host() {
  local h=$1 l parts
  [[ -n $h && ${#h} -le 253 ]] || return 1
  if [[ $h == *:* ]]; then
    [[ $h =~ ^[0-9A-Fa-f:.]+$ ]]
    return
  fi
  [[ $h != *. ]] || return 1
  IFS=. read -ra parts <<<"$h"
  for l in "${parts[@]}"; do
    [[ $l =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]] || return 1
  done
}
valid_port() { [[ $1 =~ ^[0-9]{1,5}$ ]] && ((10#$1 >= 1 && 10#$1 <= 65535)); }
valid_mount() { [[ ${#1} -le 100 && $1 =~ ^/[A-Za-z0-9._~-]+$ ]]; }
valid_bool() { [[ ${1,,} =~ ^(true|false|yes|no|y|n|on|off)$ ]]; }

# source_password_set: ICECAST_SOURCE_PASSWORD in .env is set and not the
# placeholder of .env.example. The value is never printed.
source_password_set() {
  local v
  v=$(envv ICECAST_SOURCE_PASSWORD)
  [[ -n $v && $v != change-me ]]
}

container_status() {
  local cid
  cid=$(dc ps -q "$1" 2>&5) || return 1
  [[ -n $cid ]] || return 1
  docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$cid" 2>&5
}

# wait_healthy <service> <seconds>
wait_healthy() {
  $DRY_RUN && return 0
  local deadline st
  deadline=$(($(now) + $2))
  while :; do
    st=$(container_status "$1") || st=missing
    log "$1: $st"
    [[ $st == healthy ]] && return 0
    (($(now) >= deadline)) && return 1
    sleep_s 3
  done
}

# health_gate [ready]: /readyz answers, and after the cut-over the control
# link is connected with items queued (plan 7.3 step 10).
health_gate() {
  if $DRY_RUN; then
    say "    [dry-run] health gate (${HEALTH_TIMEOUT}s)"
    return 0
  fi
  local mode=${1:-full} deadline body
  deadline=$(($(now) + HEALTH_TIMEOUT))
  while :; do
    if api_get /readyz >/dev/null; then
      if [[ $mode == ready ]] || ! cutover_done; then
        return 0
      fi
      if body=$(api_get /api/playout/status) &&
        jq -e '.control_link.connected == true and ((.queued // []) | length) > 0' <<<"$body" >/dev/null; then
        return 0
      fi
    fi
    if (($(now) >= deadline)); then
      log "health gate: timeout after ${HEALTH_TIMEOUT}s"
      return 1
    fi
    sleep_s 3
  done
}

image_info() {
  docker image inspect --format '{{.Id}} {{.Os}}/{{.Architecture}}' "$1" 2>&5 || true
}

# resolve_digest <repository> <tag>: the manifest list digest of the tag.
resolve_digest() {
  local ref=$1:$2 out line
  if docker buildx version >/dev/null 2>&1; then
    out=$(docker buildx imagetools inspect --format '{{json .Manifest}}' "$ref" 2>&5) || return 1
    jq -r '.digest // empty' <<<"$out"
    return 0
  fi
  # Without buildx: pull by tag (restarts nothing) and read the digest the
  # registry gave.
  logrun docker pull -q "$ref" || return 1
  while IFS= read -r line; do
    if [[ $line == "$1@"* ]]; then
      printf '%s\n' "${line#*@}"
      return 0
    fi
  done < <(docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$ref" 2>&5)
  return 1
}

registry_login() {
  [[ $BACKEND_IMAGE == ghcr.io/* ]] || return 0
  if $DRY_RUN; then
    say "    [dry-run] docker login ghcr.io"
    return 0
  fi
  log "+ docker login ghcr.io -u <GHCR_USER> --password-stdin"
  printf '%s' "$(envv GHCR_READ_TOKEN)" |
    docker login ghcr.io -u "$(envv GHCR_USER)" --password-stdin >&5 2>&5 ||
    die "registry login failed (GHCR_USER, GHCR_READ_TOKEN in .env)"
  local cfg=${DOCKER_CONFIG:-$HOME/.docker}/config.json
  [[ -f $cfg ]] && chmod 600 "$cfg"
  return 0
}

sha256() {
  if command -v sha256sum >/dev/null; then
    sha256sum | cut -c1-64
  else
    shasum -a 256 | cut -c1-64
  fi
}

# config_hash <dir under config/>: SHA-256 over the file names and contents.
config_hash() {
  (
    cd "$ROOT"
    find "config/$1" -type f -print0 | LC_ALL=C sort -z | xargs -0 -r cat -- | sha256
    find "config/$1" -type f | LC_ALL=C sort | sha256
  ) | sha256
}

# ---------------------------------------------------------------------------
# Preflight (plan 7.3 step 1)

# pinned_version <apt version>: 5:28.1.1-1~ubuntu.24.04~noble -> 28.1.1
pinned_version() {
  local v=${1#*:}
  printf '%s' "${v%%-*}"
}

preflight_docker() {
  docker info >/dev/null 2>&5 || die "Docker does not answer in this distribution; run install.bat"
  declare -A PINS=()
  [[ -f $ROOT/install/versions.env ]] && read_kv "$ROOT/install/versions.env" PINS
  local want have
  want=$(pinned_version "${PINS[DOCKER_CE_VERSION]:-}")
  if [[ -z $want ]]; then
    log "install/versions.env pins no Docker Engine version yet (D4); not checked"
  else
    have=$(docker version --format '{{.Server.Version}}' 2>&5) || have=unknown
    [[ $have == "$want" ]] || die "Docker Engine is $have, install/versions.env pins $want; run install.bat"
  fi
  want=$(pinned_version "${PINS[DOCKER_COMPOSE_PLUGIN_VERSION]:-}")
  if [[ -z $want ]]; then
    log "install/versions.env pins no Compose version yet (D4); not checked"
  else
    have=$(docker compose version --short 2>&5) || have=unknown
    have=${have#v}
    [[ $have == "$want" ]] || die "Docker Compose is $have, install/versions.env pins $want; run install.bat"
  fi
}

preflight() {
  step "Preflight"
  preflight_docker
  load_env || die ".env is missing: run 'radioctl first-run' (update.bat does it on a new machine)"
  check_env_vars
  [[ -f $NETWORK_ENV ]] || die "runtime/network.env is missing; radio-network.service writes it at boot (install.bat)"
}

# ---------------------------------------------------------------------------
# Fetch this repository (plan 7.3 step 2)

fetch_repo() {
  if $NO_FETCH || [[ ${RADIOCTL_REEXEC:-} == 1 ]]; then
    log "repository fetch skipped"
    return 0
  fi
  step "Fetching the deploy repository"
  if [[ ! -d $ROOT/.git ]]; then
    warn "$ROOT is not a Git checkout; not fetched"
    return 0
  fi
  local before after self_before self_after
  before=$(git -C "$ROOT" rev-parse HEAD 2>&5)
  self_before=$(sha256 <"$SELF")
  if $DRY_RUN; then
    logrun git -C "$ROOT" fetch -q || warn "git fetch failed"
    say "    [dry-run] git pull --ff-only; incoming: $(git -C "$ROOT" log --oneline "HEAD..@{u}" 2>/dev/null | wc -l) commit(s)"
    return 0
  fi
  logrun git -C "$ROOT" pull --ff-only || die "git pull --ff-only failed (local changes in $ROOT?); see $LOG_REL"
  after=$(git -C "$ROOT" rev-parse HEAD 2>&5)
  if [[ $before == "$after" ]]; then
    say "    no changes"
    return 0
  fi
  git -C "$ROOT" log --oneline "$before..$after" 2>&5 | sed 's/^/    /' >&3
  self_after=$(sha256 <"$SELF")
  if [[ $self_before != "$self_after" ]]; then
    say "    bin/radioctl changed; running the new version"
    exec 5>&-
    RADIOCTL_REEXEC=1 exec "$SELF" "${ORIG_ARGS[@]}"
  fi
}

# ---------------------------------------------------------------------------
# Database facts (psql inside db)

DB_DIRTY=f
DB_SCHEMA_VERSION=0
DB_MIN_APP=1.0.0
# "<version> t|f". A boolean cast to text is 'true'/'false', not psql's t/f
# display, hence the CASE.
SCHEMA_VERSION_SQL="SELECT version || ' ' || CASE WHEN dirty THEN 't' ELSE 'f' END FROM schema_migrations LIMIT 1"

read_db_state() {
  local out
  out=$(db_sql "SELECT to_regclass('public.schema_migrations') IS NOT NULL") || die "cannot read the database (db); see $LOG_REL"
  if [[ $out == t ]]; then
    out=$(db_sql "$SCHEMA_VERSION_SQL") || die "cannot read schema_migrations; see $LOG_REL"
    if [[ -n $out ]]; then
      DB_SCHEMA_VERSION=${out%% *}
      DB_DIRTY=${out##* }
    fi
  fi
  DB_MIN_APP=$(read_min_app) || die "cannot read schema_compat; see $LOG_REL"
  log "database: schema_version=$DB_SCHEMA_VERSION dirty=$DB_DIRTY min_app_version=$DB_MIN_APP"
}

# read_min_app: schema_compat.min_app_version; no table means 1.0.0 (§10.4).
read_min_app() {
  local out
  out=$(db_sql "SELECT to_regclass('public.schema_compat') IS NOT NULL") || return 1
  if [[ $out != t ]]; then
    echo 1.0.0
    return 0
  fi
  out=$(db_sql "SELECT min_app_version FROM schema_compat WHERE id = 1") || return 1
  echo "${out:-1.0.0}"
}

# ---------------------------------------------------------------------------
# Dumps and backups (plan 7.3 step 6, D6). BACKUP_ROOT and its Windows copy
# BACKUP_WINDOWS_COPY have the same layout:
#
#   update/db-<UTC>.dump           pre-update, maintenance, and safety dumps
#   daily/db-<UTC>.dump            the daily backup (radio-backup.timer)
#   <category>/journal-<UTC date>/ the playout journal files, copied with
#                                  each dump of that UTC day (refreshed by a
#                                  second dump on the same day)

DUMP=
BACKUP_WARNINGS=()
JOURNAL_RESULT=none
WINDOWS_RESULT=disabled

# dump_db <category>: pg_dump -Fc into BACKUP_ROOT/<category>/db-<UTC>.dump;
# sets DUMP.
dump_db() {
  local dir name i=1
  dir=$(envv BACKUP_ROOT)/$1
  name=db-$(utc_stamp)
  DUMP=$dir/$name.dump
  while [[ -e $DUMP ]]; do
    DUMP=$dir/$name-$i.dump
    i=$((i + 1))
  done
  if $DRY_RUN; then
    say "    [dry-run] pg_dump -Fc > $DUMP"
    return 0
  fi
  mkdir -p "$dir"
  log "+ pg_dump -Fc > $DUMP"
  if ! dc exec -T db pg_dump -U "$(envv POSTGRES_USER)" -d "$(envv POSTGRES_DB)" -Fc </dev/null >"$DUMP.part" 2>&5 ||
    [[ ! -s $DUMP.part ]]; then
    rm -f "$DUMP.part"
    return 1
  fi
  mv "$DUMP.part" "$DUMP"
}

# take_dump: the dump before an update, a db maintenance, or a restore, with
# its journal and Windows copies; recorded as last_dump.
take_dump() {
  dump_db update || return 1
  backup_extras "$DUMP"
  state_set '.last_dump = $d' --arg d "$DUMP"
}

# dump_date <dump>: the UTC date in its name.
dump_date() {
  local b
  b=$(basename "$1")
  if [[ $b =~ ([0-9]{4}-[0-9]{2}-[0-9]{2})T ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  else
    printf 'unknown'
  fi
}

# win_path </mnt/c/...>: the Windows spelling (C:\...), for messages.
win_path() {
  if [[ $1 =~ ^/mnt/([a-z])(/.*)?$ ]]; then
    local d=${BASH_REMATCH[1]} rest=${BASH_REMATCH[2]:-}
    printf '%s:%s' "${d^^}" "${rest//\//\\}"
  else
    printf '%s' "$1"
  fi
}

backup_warn() {
  BACKUP_WARNINGS+=("$1")
  warn "$1"
}

# backup_extras <dump>: the journal copy next to the dump and the Windows
# copy of both (D6 task 1). Their problems are warnings: the dump is the
# backup, and it exists already.
backup_extras() {
  local jdir
  jdir=$(dirname "$1")/journal-$(dump_date "$1")
  copy_journal "$jdir"
  windows_copy "$1" "$jdir"
}

# copy_file <src> <dest>, copy_dir <src> <dest>: through <dest>.part, so a
# half-written copy never has the final name. Timestamps only: the Windows
# drive keeps no Linux owner or mode.
copy_file() {
  if cp --preserve=timestamps -- "$1" "$2.part" 2>&5 && mv -f -- "$2.part" "$2"; then
    return 0
  fi
  rm -f -- "$2.part"
  return 1
}

copy_dir() {
  rm -rf -- "$2.part"
  if cp -R --preserve=timestamps -- "$1" "$2.part" 2>&5 && rm -rf -- "$2" && mv -- "$2.part" "$2"; then
    return 0
  fi
  rm -rf -- "$2.part"
  return 1
}

# copy_journal <dest dir>: the journal-*.jsonl files of PLAYOUT_JOURNAL_ROOT
# (the journal decides what aired, design §7.1).
copy_journal() {
  local dest=$1 src
  local -a files=()
  src=$(envv PLAYOUT_JOURNAL_ROOT)
  JOURNAL_RESULT=none
  if [[ ! -d $src ]]; then
    JOURNAL_RESULT=failed
    backup_warn "journal copy skipped: $src does not exist"
    return 0
  fi
  mapfile -t files < <(find "$src" -maxdepth 1 -type f -name 'journal-*.jsonl' | LC_ALL=C sort)
  if ((${#files[@]} == 0)); then
    say "    journal: no journal files yet"
    return 0
  fi
  if $DRY_RUN; then
    say "    [dry-run] copy ${#files[@]} journal file(s) to $dest"
    return 0
  fi
  local tmp=$dest.part
  rm -rf -- "$tmp"
  if mkdir -p "$tmp" && cp --preserve=timestamps -- "${files[@]}" "$tmp/" 2>&5 &&
    rm -rf -- "$dest" && mv -- "$tmp" "$dest"; then
    JOURNAL_RESULT=ok
    say "    journal: ${#files[@]} file(s) -> $dest"
    return 0
  fi
  rm -rf -- "$tmp"
  JOURNAL_RESULT=failed
  backup_warn "journal copy to $dest failed; see $LOG_REL"
}

# windows_copy <dump> <journal dir>: the same set under
# BACKUP_WINDOWS_COPY/<category>/, so a damaged virtual disk or an
# unregistered distribution does not take the backups with it. The folder
# must exist (install.bat creates it): it is never created here, because a
# missing /mnt/c would make it a folder inside the virtual disk.
windows_copy() {
  local win dest
  win=$(envv BACKUP_WINDOWS_COPY)
  WINDOWS_RESULT=disabled
  if [[ -z $win ]]; then
    log "BACKUP_WINDOWS_COPY is empty: no Windows copy"
    return 0
  fi
  if [[ ! -d $win ]]; then
    WINDOWS_RESULT=missing
    backup_warn "Windows copy skipped: $win ($(win_path "$win")) does not exist; is the drive mounted? install.bat creates it"
    return 0
  fi
  dest=$win/$(basename "$(dirname "$1")")
  if $DRY_RUN; then
    say "    [dry-run] copy $(basename "$1") and its journal folder to $dest"
    return 0
  fi
  if mkdir -p "$dest" 2>&5 && copy_file "$1" "$dest/$(basename "$1")" &&
    { [[ ! -d $2 ]] || copy_dir "$2" "$dest/$(basename "$2")"; }; then
    WINDOWS_RESULT=ok
    if [[ $(win_path "$dest") == "$dest" ]]; then
      say "    Windows copy: $dest"
    else
      say "    Windows copy: $dest ($(win_path "$dest"))"
    fi
    return 0
  fi
  WINDOWS_RESULT=failed
  backup_warn "Windows copy to $dest failed; see $LOG_REL"
}

# retain_dumps <category>: plan D6 task 3, in BACKUP_ROOT and in the Windows
# copy. daily: the newest BACKUP_DAILY_KEEP dumps. update: the newest
# BACKUP_UPDATE_KEEP, and never the recorded last_dump nor the dumps of the
# last BACKUP_BOUNDARY_KEEP history entries with boundary: true (§10.4).
# A journal-<date> folder goes when no kept dump of that date is beside it.
retain_dumps() {
  local cat=$1 keep bkeep f base
  declare -A protected=()
  # shellcheck disable=SC2034 # protected is passed by name to retain_dir
  if [[ $cat == daily ]]; then
    keep=$(envv BACKUP_DAILY_KEEP 14)
  else
    keep=$(envv BACKUP_UPDATE_KEEP 14)
    bkeep=$(envv BACKUP_BOUNDARY_KEEP 3)
    f=$(state_get '.last_dump // ""')
    [[ -n $f ]] && protected[$(basename "$f")]=1
    while IFS= read -r f; do
      [[ -n $f ]] && protected[$(basename "$f")]=1
    done < <(state_get --argjson k "$bkeep" '[.history[] | select(.boundary == true and .dump != null)] | .[-$k:] | .[].dump' 2>/dev/null || true)
  fi
  for base in "$(envv BACKUP_ROOT)" "$(envv BACKUP_WINDOWS_COPY)"; do
    [[ -n $base && -d $base/$cat ]] || continue
    retain_dir "$base/$cat" "$keep" protected "$([[ $base == "$(envv BACKUP_ROOT)" ]] || echo ' (Windows copy)')"
  done
}

# retain_dir <dir> <keep> <protected basenames (assoc name)> <label>
retain_dir() {
  local dir=$1 keep=$2 label=$4 n=0 f d
  local -n _keep_names=$3
  declare -A kept_dates=()
  while IFS= read -r f; do
    n=$((n + 1))
    if ((n <= keep)) || [[ -n ${_keep_names[$(basename "$f")]:-} ]]; then
      kept_dates[$(dump_date "$f")]=1
      continue
    fi
    say "    retention: removing $(basename "$(dirname "$f")")/$(basename "$f")$label"
    mut rm -f -- "$f"
  done < <(find "$dir" -maxdepth 1 -type f -name 'db-*.dump' | LC_ALL=C sort -r)
  while IFS= read -r d; do
    [[ -n ${kept_dates[${d##*/journal-}]:-} ]] && continue
    say "    retention: removing $(basename "$dir")/$(basename "$d")$label"
    mut rm -rf -- "$d"
  done < <(find "$dir" -mindepth 1 -maxdepth 1 -type d -name 'journal-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]' | LC_ALL=C sort)
}

# find_dump <name>: an existing path; or a name relative to BACKUP_ROOT or
# the Windows copy (update/db-....dump); or a bare file name found in their
# update/ or daily/ folder.
find_dump() {
  local base sub
  if [[ -f $1 ]]; then
    printf '%s' "$1"
    return 0
  fi
  for base in "$(envv BACKUP_ROOT)" "$(envv BACKUP_WINDOWS_COPY)"; do
    [[ -n $base ]] || continue
    for sub in "" update/ daily/; do
      if [[ -f $base/$sub$1 ]]; then
        printf '%s' "$base/$sub$1"
        return 0
      fi
    done
  done
  return 1
}

# newest_daily_dump: in BACKUP_ROOT/daily, else in the Windows copy.
newest_daily_dump() {
  local base f
  for base in "$(envv BACKUP_ROOT)" "$(envv BACKUP_WINDOWS_COPY)"; do
    [[ -n $base && -d $base/daily ]] || continue
    f=$(find "$base/daily" -maxdepth 1 -type f -name 'db-*.dump' | LC_ALL=C sort | tail -n 1)
    if [[ -n $f ]]; then
      printf '%s' "$f"
      return 0
    fi
  done
  return 1
}

# pg_restore_dump <dump>: replaces the database with the dump, in one
# transaction (a failure leaves it unchanged). backend must be stopped.
pg_restore_dump() {
  if $DRY_RUN; then
    say "    [dry-run] pg_restore --clean --if-exists --single-transaction < $1"
    return 0
  fi
  log "+ pg_restore --clean --if-exists --single-transaction < $1"
  dc exec -T db pg_restore -U "$(envv POSTGRES_USER)" -d "$(envv POSTGRES_DB)" \
    --clean --if-exists --single-transaction --no-owner <"$1" >&5 2>&5
}

dump_time() {
  local b
  b=$(basename "$1")
  if [[ $b =~ ([0-9]{4}-[0-9]{2}-[0-9]{2})T([0-9]{2})([0-9]{2})([0-9]{2})Z ]]; then
    printf '%sT%s:%s:%sZ' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"
  else
    printf 'unknown time'
  fi
}

# ---------------------------------------------------------------------------
# Daily backup (D6 tasks 1 to 3)

# run_backup: the daily dump, its journal and Windows copies, retention;
# records last_backup (and last_backup_utc on success). Returns 1 on a
# failed dump. DUMP stays the caller's (a first run records no dump).
run_backup() {
  local DUMP=
  BACKUP_WARNINGS=()
  JOURNAL_RESULT=none
  WINDOWS_RESULT=disabled
  step "Daily backup"
  if ! wait_healthy db 120; then
    backup_failed "the database container (db) is not healthy"
    return 1
  fi
  if ! dump_db daily; then
    backup_failed "pg_dump failed"
    return 1
  fi
  say "    $DUMP"
  backup_extras "$DUMP"
  step "Retention"
  retain_dumps daily
  if $DRY_RUN; then
    say "Dry run of the backup done; nothing was changed."
    return 0
  fi
  state_set '.last_backup_utc = $u
    | .last_backup = {utc: $u, result: "ok", dump: $d, journal: $j, windows_copy: $w, warnings: $warn, log: $log}' \
    --arg u "$(utc_now)" --arg d "$DUMP" --arg j "$JOURNAL_RESULT" --arg w "$WINDOWS_RESULT" \
    --arg log "$LOG_REL" --argjson warn "$(jq -cn '$ARGS.positional' --args "${BACKUP_WARNINGS[@]}")"
  if ((${#BACKUP_WARNINGS[@]})); then
    say "Backup done with ${#BACKUP_WARNINGS[@]} warning(s): $(basename "$DUMP"). Log: $LOG_REL"
  else
    say "Backup done: $(basename "$DUMP"). Log: $LOG_REL"
  fi
}

# backup_failed <reason>: last_backup_utc keeps the last success.
backup_failed() {
  printf 'ERROR: the backup failed: %s. Send the log %s to the developer.\n' "$1" "$LOG_REL" >&4
  log "ERROR: the backup failed: $1"
  state_set '.last_backup = {utc: $u, result: "failed", error: $e, log: $log}' \
    --arg u "$(utc_now)" --arg e "$1" --arg log "$LOG_REL"
}

# ---------------------------------------------------------------------------
# Restore drill (D6 task 5): the newest daily dump into a scratch database
# of the same db container. The production database is never named.

DRILL_DB=radio_restore_drill
# The main tables whose row counts the drill reports; a missing one fails it.
DRILL_TABLES=(settings tracks artists playlists clocks grid_slots scheduled_items play_log)
DRILL_ERROR='' DRILL_VERSION='' DRILL_COUNTS='{}'

drill_sql() {
  dc exec -T db psql -U "$(envv POSTGRES_USER)" -d "$1" -v ON_ERROR_STOP=1 -tAc "$2" </dev/null 2>&5
}

# drill_count_sql: one "table|rows" line per DRILL_TABLES entry; -1 when the
# table does not exist.
drill_count_sql() {
  local t list=
  for t in "${DRILL_TABLES[@]}"; do list+="${list:+,}'$t'"; done
  printf '%s' "SELECT t || '|' || CASE WHEN to_regclass('public.' || t) IS NULL THEN '-1' ELSE (xpath('/row/c/text()', query_to_xml(format('SELECT count(*) AS c FROM public.%I', t), false, true, '')))[1]::text END FROM unnest(ARRAY[$list]) AS t"
}

# drill_run <dump>: create, restore, check. Sets DRILL_ERROR on failure.
drill_run() {
  local out dirty line t c
  local -a missing=()
  DRILL_ERROR=''
  log "+ DROP DATABASE IF EXISTS $DRILL_DB; CREATE DATABASE $DRILL_DB"
  if ! drill_sql postgres "DROP DATABASE IF EXISTS $DRILL_DB WITH (FORCE)" >&5 ||
    ! drill_sql postgres "CREATE DATABASE $DRILL_DB" >&5; then
    DRILL_ERROR="the scratch database $DRILL_DB could not be created"
    return 1
  fi
  say "    restoring into $DRILL_DB"
  log "+ pg_restore -d $DRILL_DB --single-transaction --no-owner --no-privileges < $1"
  if ! dc exec -T db pg_restore -U "$(envv POSTGRES_USER)" -d "$DRILL_DB" \
    --single-transaction --no-owner --no-privileges <"$1" >&5 2>&5; then
    DRILL_ERROR="pg_restore into $DRILL_DB failed"
    return 1
  fi
  if ! out=$(drill_sql "$DRILL_DB" "$SCHEMA_VERSION_SQL") || [[ -z $out ]]; then
    DRILL_ERROR="the restored database has no schema version (schema_migrations)"
    return 1
  fi
  DRILL_VERSION=${out%% *}
  dirty=${out##* }
  if [[ $dirty != f ]]; then
    DRILL_ERROR="the restored schema (version $DRILL_VERSION) is dirty"
    return 1
  fi
  say "    schema version $DRILL_VERSION, not dirty"
  if ! out=$(drill_sql "$DRILL_DB" "$(drill_count_sql)"); then
    DRILL_ERROR="the row counts could not be read"
    return 1
  fi
  DRILL_COUNTS='{}'
  while IFS='|' read -r t c; do
    [[ -n $t ]] || continue
    if [[ $c == -1 ]]; then
      missing+=("$t")
      continue
    fi
    DRILL_COUNTS=$(jq -c --arg t "$t" --argjson c "$c" '. + {($t): $c}' <<<"$DRILL_COUNTS")
    line=$(printf '%-16s %s' "$t" "$c")
    say "    rows: $line"
  done <<<"$out"
  if ((${#missing[@]})); then
    DRILL_ERROR="tables missing in the restored database: ${missing[*]}"
    return 1
  fi
}

# ---------------------------------------------------------------------------
# Air check (plan 7.3 step 4)

PREPUSH=5
STATION_TZ=UTC

read_window_settings() {
  local v
  if v=$(setting playout.prepush_minutes) && [[ $v =~ ^[0-9]+$ ]]; then
    PREPUSH=$v
  else
    warn "playout.prepush_minutes could not be read; using $PREPUSH"
  fi
  if v=$(setting station.timezone) && [[ -n $v ]]; then
    STATION_TZ=$v
  fi
}

# window_wait: not within prepush + 1 minute before a station hour, nor in
# the first minute after it.
window_wait() {
  local t m s into wait
  while :; do
    t=$(now)
    read -r m s < <(fmt_time "$STATION_TZ" '%M %S' "$t")
    into=$((10#$m * 60 + 10#$s))
    if ((3600 - into <= (PREPUSH + 1) * 60)); then
      wait=$((3600 - into + 60))
    elif ((into < 60)); then
      wait=$((60 - into))
    else
      return 0
    fi
    if $NO_WAIT; then
      say "The next hour's items are being pushed (within ${PREPUSH}+1 minutes of the hour); stopped (--no-wait)."
      return 1
    fi
    say "    waiting ${wait}s: the next hour's items are being pushed"
    sleep_s "$wait"
  done
}

air_check() {
  if ! cutover_done; then
    say "    before the cut-over: air check skipped"
    return 0
  fi
  step "Air check"
  local body st on_air deadline
  if body=$(api_get /api/broadcast/status); then
    st=$(jq -r '.state' <<<"$body")
    log "broadcast state: $st"
    if [[ $st == unreachable ]]; then
      say "An outage is open (the stream server is unreachable): the update is stopped. Nothing was changed."
      return 1
    fi
  else
    confirm "The broadcast status could not be read. Continue anyway?" || return 1
  fi
  if body=$(api_get /api/status/live); then
    on_air=$(jq -r '.on_air' <<<"$body")
    log "live on_air: $on_air"
    if [[ $on_air != false ]]; then
      confirm "Live voice may be on air (on_air: $on_air); it will drop during the update. Continue?" || return 1
    fi
  else
    confirm "The live voice status could not be read. Continue anyway?" || return 1
  fi
  deadline=$(($(now) + 120))
  while :; do
    if ! body=$(api_get /api/playout/status); then
      confirm "The playout status could not be read. Continue anyway?" || return 1
      break
    fi
    if jq -e '.control_link.connected == true and ((.queued // []) | length) >= 2' <<<"$body" >/dev/null; then
      break
    fi
    log "playout: $(jq -c '{connected: .control_link.connected, queued: ((.queued // []) | length)}' <<<"$body")"
    if (($(now) >= deadline)); then
      say "Liquidsoap has fewer than 2 items queued or no control link after 2 minutes: the update is stopped. Nothing was changed."
      return 1
    fi
    say "    waiting: fewer than 2 items queued in Liquidsoap"
    sleep_s 10
  done
  read_window_settings
  window_wait
}

# ---------------------------------------------------------------------------
# Prompts

confirm() {
  if $YES; then
    say "$1 yes (--yes)"
    return 0
  fi
  if $DRY_RUN; then
    say "    [dry-run] would ask: $1"
    return 0
  fi
  local ans=
  printf '%s [y/N] ' "$1" >&3
  IFS= read -r ans || ans=
  log "$1 -> $ans"
  [[ $ans =~ ^[Yy]([Ee][Ss])?$ ]]
}

# typed <word> <text>: the destructive confirmation; --yes does not answer it.
typed() {
  if $DRY_RUN; then
    say "    [dry-run] would ask to type $1"
    return 0
  fi
  local ans=
  printf '%s\nType %s to continue: ' "$2" "$1" >&3
  IFS= read -r ans || ans=
  log "typed confirmation $1: $([[ $ans == "$1" ]] && echo given || echo refused)"
  [[ $ans == "$1" ]]
}

# ---------------------------------------------------------------------------
# Liquidsoap and db: applied values and pending maintenance (plan 7.3 step 13)

# infra_now: the JSON of the liquidsoap and db values this repository
# would apply now. liquidsoap_env_sha256 is a hash of liquidsoap's rendered
# environment, which holds .env values Liquidsoap reads only when it starts
# (ICECAST_SOURCE_PASSWORD, LIQUIDSOAP_CONTROL_*): a changed password is a
# pending change. Only the hash is kept; no value is printed or logged.
infra_now() {
  local cfg contract
  cfg=$(dc config --format json 2>&5) || return 1
  contract=$(script_contract "$SCRIPT_FILE" || echo 0)
  jq -n --argjson cfg "$cfg" \
    --arg script "$(sha256 <"$SCRIPT_FILE")" \
    --argjson contract "$contract" \
    --arg ldef "$(jq -cS '.services.liquidsoap' <<<"$cfg" | sha256)" \
    --arg lenv "$(jq -cS '.services.liquidsoap.environment // {}' <<<"$cfg" | sha256)" \
    --arg ddef "$(jq -cS '.services.db' <<<"$cfg" | sha256)" \
    '{liquidsoap_image: $cfg.services.liquidsoap.image, liquidsoap_script_sha256: $script,
      liquidsoap_contract: $contract, liquidsoap_definition_sha256: $ldef,
      liquidsoap_env_sha256: $lenv,
      db_image: $cfg.services.db.image, db_definition_sha256: $ddef}'
}

# backfill_env_hash <infra_now json>: a state.json from before
# liquidsoap_env_sha256 gets it when the definition (which contains the
# environment) is unchanged, so the environment is the applied one.
backfill_env_hash() {
  [[ -z $(state_get '.applied.liquidsoap_env_sha256 // empty') ]] || return 0
  [[ -n $(state_get '.applied.liquidsoap_image // empty') ]] || return 0
  state_set 'if .applied.liquidsoap_definition_sha256 == $n.liquidsoap_definition_sha256
    then .applied.liquidsoap_env_sha256 = $n.liquidsoap_env_sha256 else . end' --argjson n "$1"
}

# pending_list <infra_now json>: one line per difference to state.applied.
pending_list() {
  jq -r --argjson now "$1" '
    .applied as $a |
    (if ($a.liquidsoap_image // null) != $now.liquidsoap_image then "liquidsoap image \($a.liquidsoap_image // "unknown") -> \($now.liquidsoap_image)" else empty end),
    (if ($a.liquidsoap_contract // null) != $now.liquidsoap_contract then "liquidsoap script contract \($a.liquidsoap_contract // "unknown") -> \($now.liquidsoap_contract)"
     elif ($a.liquidsoap_script_sha256 // null) != $now.liquidsoap_script_sha256 then "liquidsoap script config/liquidsoap/radio.liq changed" else empty end),
    (if ($a.liquidsoap_env_sha256 // null) != null and $a.liquidsoap_env_sha256 != $now.liquidsoap_env_sha256 then "liquidsoap environment changed (.env values it reads at start, e.g. ICECAST_SOURCE_PASSWORD)"
     elif ($a.liquidsoap_definition_sha256 // null) != $now.liquidsoap_definition_sha256 and ($a.liquidsoap_image // null) == $now.liquidsoap_image then "liquidsoap service definition changed" else empty end),
    (if ($a.db_image // null) != $now.db_image then "db image \($a.db_image // "unknown") -> \($now.db_image)" else empty end),
    (if ($a.db_definition_sha256 // null) != $now.db_definition_sha256 and ($a.db_image // null) == $now.db_image then "db service definition changed" else empty end)
  ' "$STATE_FILE"
}

report_pending() {
  step "Pending maintenance"
  local infra list
  if ! infra=$(infra_now); then
    warn "could not render the compose file to compare liquidsoap and db"
    return 0
  fi
  if [[ -z $(state_get '.applied.liquidsoap_image // empty') ]]; then
    warn "no applied liquidsoap/db record in state.json; recording the current values as applied"
    state_set '.applied += $n' --argjson n "$infra"
    return 0
  fi
  backfill_env_hash "$infra"
  list=$(pending_list "$infra")
  if [[ -z $list ]]; then
    say "    none"
  else
    while IFS= read -r l; do
      say "    pending: $l"
    done <<<"$list"
    say "    Liquidsoap and db were not restarted. Run 'update.bat maintenance' in a maintenance window."
  fi
  state_set '.pending_maintenance = ($l | split("\n") | map(select(. != "")))' --arg l "$list"
}

# ---------------------------------------------------------------------------
# Loki, Alloy, Grafana (plan 7.3 step 12; failures are warnings)

CONFIG_HASHES='{}'

apply_monitoring() {
  step "Loki, Alloy, Grafana"
  local svc dir h old force
  CONFIG_HASHES=$(jq -n --arg l "$(config_hash loki)" --arg a "$(config_hash alloy)" --arg g "$(config_hash grafana)" \
    '{loki: $l, alloy: $a, grafana: $g}')
  for svc in loki alloy; do
    dir=$svc
    h=$(jq -r --arg s "$dir" '.[$s]' <<<"$CONFIG_HASHES")
    old=$(state_get --arg s "$dir" '.applied.config_sha256[$s] // empty')
    force=()
    if [[ -n $old && $old != "$h" ]]; then
      say "    $svc: configuration changed; recreating"
      force=(--force-recreate)
    fi
    mut dc up -d --no-deps "${force[@]}" "$svc" || warn "monitoring: failed ($svc); see $LOG_REL"
  done
  if monitoring_enabled; then
    h=$(jq -r '.grafana' <<<"$CONFIG_HASHES")
    old=$(state_get '.applied.config_sha256.grafana // empty')
    force=()
    [[ -n $old && $old != "$h" ]] && force=(--force-recreate)
    if mut dc run --rm --no-deps -T grafana-role </dev/null; then
      mut dc up -d --no-deps --wait "${force[@]}" grafana || warn "monitoring: failed (grafana); see $LOG_REL"
    else
      warn "monitoring: failed (grafana-role); see $LOG_REL"
    fi
  else
    local cid
    cid=$(docker ps -q --filter "label=com.docker.compose.project=$PROJECT" \
      --filter label=com.docker.compose.service=grafana 2>&5 || true)
    if [[ -n $cid ]]; then
      mut docker stop "$cid" || warn "monitoring: could not stop grafana"
    fi
  fi
}

# ---------------------------------------------------------------------------
# Install of a release (plan 7.3, 7.4, §10.4)

# Target and running release.
T_BTAG='' T_BDIG='' T_FTAG='' T_FDIG=''
C_BTAG='' C_BDIG='' C_FTAG='' C_FDIG=''
KIND=update
TARGET_LABEL='' CURRENT_LABEL=''
DIRECTION=newer
RESTORE_DUMP='' RESTORE_FROM=''

load_current() {
  C_BTAG=$(state_get '.current.backend_tag // empty')
  C_BDIG=$(state_get '.current.backend_digest // empty')
  C_FTAG=$(state_get '.current.frontend_tag // empty')
  C_FDIG=$(state_get '.current.frontend_digest // empty')
  CURRENT_LABEL=$(release_label "$C_BTAG" "$C_FTAG")
}

# history_add <result> [restored] [min_app_after]
history_add() {
  local restored=${2:-false} after=${3:-$DB_MIN_APP}
  local boundary=false
  [[ $1 == ok ]] && ver_gt "$after" "$DB_MIN_APP" && boundary=true
  state_set '.history += [{utc: $utc, kind: $kind, from: $from, to: $to,
      from_frontend: $ff, to_frontend: $tf, result: $res,
      dump: (if $dump == "" then null else $dump end),
      schema_version_before: ($sv | tonumber), min_app_version_before: $before,
      min_app_version_after: $after, boundary: $boundary, restored: $restored, log: $log}]' \
    --arg utc "$(utc_now)" --arg kind "$KIND" --arg from "$C_BTAG" --arg to "$T_BTAG" \
    --arg ff "$C_FTAG" --arg tf "$T_FTAG" --arg res "$1" --arg dump "$DUMP" \
    --arg sv "$DB_SCHEMA_VERSION" --arg before "$DB_MIN_APP" --arg after "$after" \
    --argjson boundary "$boundary" --argjson restored "$restored" --arg log "$LOG_REL"
}

# undone <result> [restored] [note]: the plain message of every failure
# path (plan 7.3 steps 7 and 14); records it and exits 1.
undone() {
  history_add "$1" "${2:-false}"
  state_set '.last_result = "failed" | del(.target)'
  say ""
  if [[ -n ${3:-} ]]; then
    say "Update to $TARGET_LABEL failed and $3. Send the log $LOG_REL to the developer."
  else
    say "Update to $TARGET_LABEL failed and was undone. Broadcasting continues on $CURRENT_LABEL. Send the log $LOG_REL to the developer."
  fi
  say "(full path: $LOG_FILE)"
  exit 1
}

# refuse <text>: a stop before any change.
refuse() {
  say ""
  say "$1"
  say "Nothing was changed. Log: $LOG_REL"
  state_set 'del(.target)'
  exit 1
}

release_check() {
  step "Release check: $TARGET_LABEL"
  local t min_backend d
  for t in "$T_BTAG" "$T_FTAG"; do
    is_semver "$t" || refuse "Refused: '$t' is not a release tag (X.Y.Z)."
    ver_lt "$t" 1.0.0 && refuse "Refused: $t is below 1.0.0; no release below 1.0.0 is installed."
  done
  [[ $(major_minor "$T_BTAG") == "$(major_minor "$T_FTAG")" ]] ||
    refuse "Refused: backend $T_BTAG and frontend $T_FTAG differ in MAJOR.MINOR (11.7)."
  min_backend=$(script_min_backend "$SCRIPT_FILE") || refuse "Refused: config/liquidsoap/radio.liq has no min-backend header."
  ver_lt "$T_BTAG" "$min_backend" &&
    refuse "Refused: backend $T_BTAG is below $min_backend, the min-backend of config/liquidsoap/radio.liq."
  registry_login
  d=$(resolve_digest "$BACKEND_IMAGE" "$T_BTAG") || d=
  [[ -n $d ]] ||
    refuse "Refused: the image $BACKEND_IMAGE:$T_BTAG was not found in the registry."
  if [[ -z $T_BDIG ]]; then
    T_BDIG=$d
  elif [[ $d != "$T_BDIG" ]]; then
    refuse "Refused: $BACKEND_IMAGE:$T_BTAG is $d in the registry, not $T_BDIG."
  fi
  d=$(resolve_digest "$FRONTEND_IMAGE" "$T_FTAG") || d=
  [[ -n $d ]] ||
    refuse "Refused: the image $FRONTEND_IMAGE:$T_FTAG was not found in the registry."
  if [[ -z $T_FDIG ]]; then
    T_FDIG=$d
  elif [[ $d != "$T_FDIG" ]]; then
    refuse "Refused: $FRONTEND_IMAGE:$T_FTAG is $d in the registry, not $T_FDIG."
  fi
  say "    backend  $T_BTAG $T_BDIG"
  say "    frontend $T_FTAG $T_FDIG"

  read_db_state
  if [[ $DB_DIRTY == t ]]; then
    undone failed false "was not started: the database is dirty (schema version $DB_SCHEMA_VERSION). Broadcasting continues on $CURRENT_LABEL"
  fi
  case $(ver_cmp "$T_BTAG" "$C_BTAG") in
    1) DIRECTION=newer ;;
    -1) DIRECTION=older ;;
    0) DIRECTION=same ;;
  esac
  log "direction: $DIRECTION (running $C_BTAG, target $T_BTAG)"
  if [[ $DIRECTION == older ]] && ver_lt "$T_BTAG" "$DB_MIN_APP"; then
    offer_boundary_restore
  fi
}

# offer_boundary_restore: the target is below min_app_version (§10.4).
offer_boundary_restore() {
  say ""
  say "Refused: the database needs at least release $DB_MIN_APP (a contract migration raised it); $T_BTAG is older."
  local entries line dump utc from
  entries=$(state_get --arg t "$T_BTAG" '
    def v: split(".") | map(tonumber);
    [.history[] | select(.dump != null and .min_app_version_before != null
       and (.min_app_version_before | v) <= ($t | v))] | reverse | .[] | [.dump, .utc, .from] | @tsv')
  local -a cands=()
  while IFS=$'\t' read -r dump utc from; do
    [[ -n $dump && -f $dump ]] && cands+=("$dump"$'\t'"$utc"$'\t'"$from")
  done <<<"$entries"
  if ((${#cands[@]} == 0)); then
    refuse "No dump taken while the database still accepted $T_BTAG is available."
  fi
  say "Restore points (pre-update dumps taken while the database accepted $T_BTAG), newest first:"
  for line in "${cands[@]}"; do
    IFS=$'\t' read -r dump utc from <<<"$line"
    say "    $(basename "$dump")  taken $(dump_time "$dump") before the update from $from"
  done
  IFS=$'\t' read -r dump utc from <<<"${cands[0]}"
  say "Restoring $(basename "$dump") loses every change since $(dump_time "$dump"): the plan, the play log, settings, and library edits."
  if ! typed RESTORE "To restore it and then install $TARGET_LABEL,"; then
    refuse "Not confirmed."
  fi
  RESTORE_DUMP=$dump
  RESTORE_FROM=$from
  KIND=restore-install
}

record_target() {
  local bi fimg
  bi=$(image_info "$BACKEND_IMAGE:$T_BTAG@$T_BDIG")
  fimg=$(image_info "$FRONTEND_IMAGE:$T_FTAG@$T_FDIG")
  state_set '.target = {backend_tag: $bt, backend_digest: $bd, frontend_tag: $ft, frontend_digest: $fd,
      backend_image_id: ($bi | split(" ")[0]), frontend_image_id: ($fimg | split(" ")[0]),
      platform: ($bi | split(" ")[1] // null)} | .last_result = "pending"' \
    --arg bt "$T_BTAG" --arg bd "$T_BDIG" --arg ft "$T_FTAG" --arg fd "$T_FDIG" --arg bi "$bi" --arg fimg "$fimg"
}

# migrate_step: plan 7.3 step 7 (newer targets only).
migrate_step() {
  step "Migrating the database (the running backend keeps serving)"
  local tc rc=0 stopped=false
  if $DRY_RUN; then
    say "    [dry-run] migrate target-compat; migrate up"
    return 0
  fi
  if ! tc=$(dct run --rm --no-deps -T migrate migrate target-compat </dev/null 2>&5) || ! is_semver "${tc//[[:space:]]/}"; then
    undone failed
  fi
  tc=${tc//[[:space:]]/}
  log "target min_app_version (target-compat): $tc"
  if ver_lt "$C_BTAG" "$tc"; then
    say "    $C_BTAG cannot run on the migrated schema (needs $tc): stopping the backend first"
    logrun dc stop backend || undone failed
    stopped=true
  fi
  logrun dct run --rm --no-deps -T migrate </dev/null || rc=$?
  log "migrate up exit code: $rc"
  case $rc in
    0)
      DB_MIN_APP_AFTER=$(read_min_app) || DB_MIN_APP_AFTER=$DB_MIN_APP
      return 0
      ;;
    5)
      say "    the migration left the database dirty: restoring the pre-update dump"
      auto_restore
      ;;
    *)
      if ((rc == 4)); then
        say "    the migration failed and was rolled back; the schema is unchanged"
      else
        say "    the migration did not run (exit $rc); the database was not changed"
      fi
      if $stopped; then
        start_old_backend || undone failed false "was undone, but the backend did not pass its health check. Broadcasting may continue from the Liquidsoap queue only"
      fi
      undone rolled_back
      ;;
  esac
}

start_old_backend() {
  logrun dc up -d --no-deps backend || return 1
  health_gate
}

# auto_restore: exit 5 (plan 7.3 step 7): restore this run's dump without a
# prompt, start the old backend.
auto_restore() {
  local ok=true
  logrun dc stop backend || true
  pg_restore_dump "$DUMP" || ok=false
  if start_old_backend; then
    if $ok; then
      undone rolled_back true
    fi
    undone failed false "the database could not be restored automatically; the developer must check it. Broadcasting continues on $CURRENT_LABEL"
  fi
  if $ok; then
    undone failed true "was undone, but $CURRENT_LABEL did not pass its health check after the restore; the developer must check it"
  fi
  undone failed false "the database could not be restored automatically, and $CURRENT_LABEL did not pass its health check; the developer must check it"
}

# restore_for_downgrade: the typed-RESTORE path of §10.4.
restore_for_downgrade() {
  step "Restoring $(basename "$RESTORE_DUMP") for $TARGET_LABEL"
  mut dc stop backend || true
  if ! pg_restore_dump "$RESTORE_DUMP"; then
    start_old_backend || true
    undone failed false "the database could not be restored; it is unchanged. Broadcasting continues on $CURRENT_LABEL"
  fi
  DB_MIN_APP_AFTER=$(read_min_app 2>/dev/null || echo "$DB_MIN_APP")
  if [[ -n $RESTORE_FROM ]] && ver_gt "$T_BTAG" "$RESTORE_FROM"; then
    say "    the dump is from $RESTORE_FROM: migrating to $T_BTAG"
    local rc=0
    mut dct run --rm --no-deps -T migrate </dev/null || rc=$?
    ((rc == 0)) || undone failed true "after the restore of $(basename "$RESTORE_DUMP") (migrate exit $rc); the developer must check it. The backend is stopped"
  fi
}

# rollback_app: plan 7.3 step 14.
rollback_app() {
  say "    $1: rolling back to $CURRENT_LABEL"
  if [[ -n $RESTORE_DUMP ]]; then
    undone failed true "after the restore of $(basename "$RESTORE_DUMP"); the previous release cannot run on the restored database. The developer must check it"
  fi
  write_app_env "$APPLIED_ENV" "$C_BTAG" "$C_BDIG" "$C_FTAG" "$C_FDIG"
  logrun dc up -d --no-deps backend frontend || true
  if health_gate; then
    undone rolled_back
  fi
  undone failed false "was rolled back to $CURRENT_LABEL, which did not pass its health check either; the developer must check it"
}

# refresh_app_env: the running release stays, but a value applied.env
# derives from .env (GRAFANA_URL from MONITORING_ENABLED and GRAFANA_PORT)
# may have changed since it was written. Then applied.env is rewritten and
# only the frontend is recreated (about a second; the backend and the air
# are not touched). Nothing changed: nothing is done.
refresh_app_env() {
  local want have old new
  want=$(app_env_body "$C_BTAG" "$C_BDIG" "$C_FTAG" "$C_FDIG")
  have=$(grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$APPLIED_ENV" 2>/dev/null || true)
  [[ $want == "$have" ]] && return 0
  step "Panel settings from .env"
  old=$(sed -n 's/^GRAFANA_URL=//p' <<<"$have" | tail -n 1)
  new=$(sed -n 's/^GRAFANA_URL=//p' <<<"$want")
  if [[ $old != "$new" ]]; then
    say "    Grafana link: ${old:-none} -> ${new:-none}"
  else
    say "    runtime/applied.env differs from the running release; rewriting it"
  fi
  write_app_env "$APPLIED_ENV" "$C_BTAG" "$C_BDIG" "$C_FTAG" "$C_FDIG"
  say "    recreating the panel only (about a second; the backend and the air are not touched)"
  if ! mut dc up -d --no-deps frontend || ! wait_healthy frontend 60; then
    warn "the panel (frontend) did not become healthy after the recreate; see $LOG_REL"
    return 0
  fi
  $DRY_RUN || say "    healthy"
}

DB_MIN_APP_AFTER=

install_release() {
  load_current
  TARGET_LABEL=$(release_label "$T_BTAG" "$T_FTAG")
  release_check
  DB_MIN_APP_AFTER=$DB_MIN_APP

  if [[ $DIRECTION == same && $T_BDIG == "$C_BDIG" && $T_FTAG == "$C_FTAG" && $T_FDIG == "$C_FDIG" && -z $RESTORE_DUMP ]]; then
    say "Release $TARGET_LABEL is already running."
    apply_monitoring
    refresh_app_env
    report_pending
    state_set '.applied.config_sha256 = $h' --argjson h "$CONFIG_HASHES"
    say "Done."
    return 0
  fi

  air_check || refuse "Update to $TARGET_LABEL not started."

  step "Pulling images"
  write_app_env "$TARGET_ENV" "$T_BTAG" "$T_BDIG" "$T_FTAG" "$T_FDIG"
  mut dct pull -q || refuse "Pulling the images failed; see $LOG_REL."
  record_target

  step "Database dump (mandatory)"
  take_dump || refuse "The database dump failed; the update is stopped."
  say "    $DUMP"

  if [[ -n $RESTORE_DUMP ]]; then
    restore_for_downgrade
  elif [[ $DIRECTION == newer ]]; then
    migrate_step
  else
    say "    $DIRECTION release: no migration"
  fi

  if cutover_done && [[ -z $RESTORE_DUMP ]]; then
    window_wait || undone rolled_back
  fi

  step "Backend $T_BTAG"
  write_app_env "$APPLIED_ENV" "$T_BTAG" "$T_BDIG" "$T_FTAG" "$T_FDIG"
  mut dc up -d --no-deps backend || rollback_app "backend did not start"
  health_gate || rollback_app "backend did not pass its health check within ${HEALTH_TIMEOUT}s"
  $DRY_RUN || say "    healthy"

  step "Frontend $T_FTAG"
  mut dc up -d --no-deps frontend || rollback_app "frontend did not start"
  wait_healthy frontend 60 || rollback_app "frontend did not become healthy"
  $DRY_RUN || say "    healthy"

  apply_monitoring
  report_pending
  finish_install
}

finish_install() {
  step "Finishing"
  local bi fimg
  bi=$(image_info "$BACKEND_IMAGE:$T_BTAG@$T_BDIG")
  fimg=$(image_info "$FRONTEND_IMAGE:$T_FTAG@$T_FDIG")
  history_add ok "$([[ -n $RESTORE_DUMP ]] && echo true || echo false)" "$DB_MIN_APP_AFTER"
  state_set '.previous = .current
    | .current = {backend_tag: $bt, backend_digest: $bd, frontend_tag: $ft, frontend_digest: $fd,
        backend_image_id: ($bi | split(" ")[0]), frontend_image_id: ($fimg | split(" ")[0]),
        platform: ($bi | split(" ")[1] // null)}
    | .applied.config_sha256 = $h | .last_update_utc = $utc | .last_result = "ok" | del(.target)' \
    --arg bt "$T_BTAG" --arg bd "$T_BDIG" --arg ft "$T_FTAG" --arg fd "$T_FDIG" \
    --arg bi "$bi" --arg fimg "$fimg" --argjson h "$CONFIG_HASHES" --arg utc "$(utc_now)"
  retain_dumps update
  local rel_b
  rel_b=$(sed -n 's/^BACKEND_TAG=//p' "$RELEASE_FILE" | tr -d '\r"')
  if [[ $KIND != update || -n $RESTORE_DUMP ]] && [[ $rel_b != "$T_BTAG" ]]; then
    say "    note: the running release differs from release.env ($rel_b); a plain update.bat returns to it"
  fi
  say ""
  if $DRY_RUN; then
    say "Dry run of the install of $TARGET_LABEL (running: $CURRENT_LABEL) done; nothing was changed."
    return 0
  fi
  say "Installed $TARGET_LABEL (was $CURRENT_LABEL). Log: $LOG_REL"
}

# ---------------------------------------------------------------------------
# Commands

usage() {
  cat <<'EOF'
Usage: radioctl [options] <command> [arguments]

Commands:
  update [<backendTag> [<frontendTag>]]
                    install release.env, or the given release (>= 1.0.0, newer
                    or older; the frontend tag defaults to the backend tag)
  rollback          install the release that ran before the last update
  restore [<dump>]  restore the database from the last update dump or <dump>
                    (typed RESTORE)
  maintenance       apply pending liquidsoap/db changes (typed MAINTENANCE)
  cutover [--undo]  start liquidsoap on the mount of the panel's stream
                    settings (shown, typed CUTOVER), or stop it again
  first-run [--media-root <path>]
                    first configuration of a new machine (called by install.bat);
                    proposes config/stream-defaults.json as the stream settings
  status            release, containers, air, pending maintenance, backups, disk
  logs [<service>]  the last run log, or the container logs of a service
  compose <args>    docker compose with the production files (diagnostics only)
  backup            the daily backup: database dump, journal copy, Windows copy,
                    retention (radio-backup.timer runs it at 04:30)
  restore-drill [<dump>]
                    restore the newest daily dump (or <dump>) into a scratch
                    database, check it, drop it (monthly; never touches the
                    production database)
  network [--mode nat|mirrored]
                    write runtime/network.env (LIVE_UDP_BIND, LIVE_PUBLIC_IPS)
                    for the WSL network mode and recreate the backend if they
                    changed (radio-network.service runs it at boot)
  boot-check        wait up to 10 minutes for the stack to be healthy and
                    record the result in logs/boot-*.log (radio-boot-check)

Options:
  --dry-run   print every step and change nothing
  --yes       answer yes to the non-destructive questions (never to the typed
              words RESTORE, MAINTENANCE, CUTOVER)
  --no-wait   stop instead of waiting for the prepush window to pass
  --no-fetch  do not git pull this repository first
EOF
}

cmd_update() {
  (($# <= 2)) || die "update takes at most two tags"
  if ! installed; then
    (($# == 0)) || die "no release is installed yet; the first run installs release.env (radioctl first-run)"
    say "No installed release is recorded: running the first run."
    # shellcheck disable=SC2119 # the first run from update takes no options
    cmd_first_run
    return
  fi
  preflight
  report_backup_failure
  fetch_repo
  if (($# == 0)); then
    declare -A REL=()
    read_kv "$RELEASE_FILE" REL
    T_BTAG=${REL[BACKEND_TAG]:-}
    T_BDIG=${REL[BACKEND_DIGEST]:-}
    T_FTAG=${REL[FRONTEND_TAG]:-}
    T_FDIG=${REL[FRONTEND_DIGEST]:-}
    [[ -n $T_BDIG && -n $T_FDIG ]] || die "release.env has no digest for $T_BTAG/$T_FTAG; a release PR must set them"
    KIND=update
  else
    T_BTAG=$1
    T_FTAG=${2:-$1}
    KIND=update
  fi
  install_release
}

cmd_rollback() {
  (($# == 0)) || die "rollback takes no arguments"
  installed || die "no release is installed"
  preflight
  T_BTAG=$(state_get '.previous.backend_tag // empty')
  [[ -n $T_BTAG ]] || die "no previous release is recorded; nothing to roll back to"
  T_BDIG=$(state_get '.previous.backend_digest // empty')
  T_FTAG=$(state_get '.previous.frontend_tag // empty')
  T_FDIG=$(state_get '.previous.frontend_digest // empty')
  KIND=rollback
  install_release
}

cmd_restore() {
  (($# <= 1)) || die "restore takes at most one dump"
  installed || die "no release is installed"
  preflight
  local name=${1:-$(state_get '.last_dump // empty')} dump
  [[ -n $name ]] || die "no dump is recorded; name one: radioctl restore <dump>"
  # A path, update/... or daily/..., or a bare name, in BACKUP_ROOT or the
  # Windows copy (the last_dump of a lost BACKUP_ROOT is found there too).
  dump=$(find_dump "$name") || dump=$(find_dump "$(basename "$name")") ||
    die "dump not found: $name"
  load_current
  step "Restore $(basename "$dump") (taken $(dump_time "$dump"))"
  say "The database is replaced by this dump; every change since then is lost."
  say "The backend stops for the restore; Liquidsoap keeps playing its queue. The release ($CURRENT_LABEL) does not change."
  typed RESTORE "Restore $(basename "$dump")?" || refuse "Not confirmed."
  step "Safety dump of the current database"
  take_dump || refuse "The safety dump failed; nothing was restored."
  say "    $DUMP"
  step "Restoring"
  mut dc stop backend || true
  if ! pg_restore_dump "$dump"; then
    start_old_backend || true
    state_set '.last_result = "failed"'
    die "the restore failed; the database is unchanged (one transaction). Send the log $LOG_REL to the developer"
  fi
  # The schema now has the dump's version: apply the running release's
  # migrations if it is newer (a no-op otherwise).
  local rc=0
  mut dc run --rm --no-deps -T migrate </dev/null || rc=$?
  ((rc == 0)) || warn "migrate up after the restore exited $rc; see $LOG_REL"
  mut dc up -d --no-deps backend || true
  if ! health_gate; then
    state_set '.last_result = "failed"'
    die "the database was restored but the backend did not pass its health check; send the log $LOG_REL to the developer"
  fi
  state_set '.last_restore = {utc: $u, dump: $d, safety_dump: $s}' --arg u "$(utc_now)" --arg d "$dump" --arg s "$DUMP"
  say "Restored $(basename "$dump"). Log: $LOG_REL"
}

cmd_maintenance() {
  (($# == 0)) || die "maintenance takes no arguments"
  installed || die "no release is installed"
  preflight
  step "Pending maintenance"
  local infra list body l db_aff=false ls_aff=false
  infra=$(infra_now) || die "cannot render the compose file; see $LOG_REL"
  backfill_env_hash "$infra"
  list=$(pending_list "$infra")
  if [[ -z $list ]]; then
    say "Nothing is pending."
    state_set '.pending_maintenance = []'
    return 0
  fi
  while IFS= read -r l; do
    say "    $l"
    [[ $l == db* ]] && db_aff=true
    [[ $l == liquidsoap* ]] && ls_aff=true
  done <<<"$list"
  if cutover_done && body=$(api_get /api/playout/status); then
    say "Planned in the next 15 minutes:"
    jq -r --arg limit "$(fmt_time UTC '%Y-%m-%dT%H:%M:%SZ' "$(($(now) + 900))")" \
      '.queued // [] | .[] | select(.planned_start_utc <= $limit) | "    \(.planned_start_utc)  \(.artist_name // "") - \(.title)"' <<<"$body" >&3 || true
  fi
  if $ls_aff && cutover_done; then
    say "The stream stops for some seconds while liquidsoap restarts. The backend records an outage and marks"
    say "items missed unless the playout journal confirms them."
  fi
  $db_aff && say "The database restarts: the backend and the panel are unavailable for some seconds."
  typed MAINTENANCE "Apply these changes now?" || refuse "Not confirmed."
  if $db_aff; then
    step "Database dump (db is affected)"
    take_dump || refuse "The database dump failed; nothing was restarted."
    say "    $DUMP"
    step "Recreating db"
    mut dc up -d --no-deps --force-recreate db || die "db did not start; send the log $LOG_REL to the developer"
    wait_healthy db 120 || die "db did not become healthy; send the log $LOG_REL to the developer"
    health_gate ready || die "the backend did not reconnect to db; send the log $LOG_REL to the developer"
  fi
  if $ls_aff; then
    if cutover_done; then
      step "Recreating liquidsoap"
      mut dc up -d --no-deps --force-recreate liquidsoap || die "liquidsoap did not start; send the log $LOG_REL to the developer"
      if ! wait_liquidsoap 60; then
        state_set '.last_result = "failed"'
        say "Liquidsoap did not come back (health, control link, output connected) within 60 s."
        say "The previous values are in state.json (applied). Send the log $LOG_REL to the developer."
        exit 1
      fi
    else
      say "    liquidsoap is not started before the cut-over; the change applies at the cut-over"
    fi
  fi
  state_set '.applied += $n | .pending_maintenance = [] | .last_maintenance_utc = $u' \
    --argjson n "$infra" --arg u "$(utc_now)"
  say "Maintenance done. Log: $LOG_REL"
}

# wait_liquidsoap <seconds>: health check, control link, output connected.
wait_liquidsoap() {
  $DRY_RUN && return 0
  wait_healthy liquidsoap "$1" || return 1
  local deadline body
  deadline=$(($(now) + $1))
  while :; do
    if body=$(api_get /api/playout/status) &&
      jq -e '.control_link.connected == true and .output.state == "connected"' <<<"$body" >/dev/null; then
      return 0
    fi
    (($(now) >= deadline)) && return 1
    sleep_s 3
  done
}

cmd_cutover() {
  local undo=false
  case ${1:-} in
    --undo) undo=true ;;
    "") ;;
    *) die "cutover takes only --undo" ;;
  esac
  installed || die "no release is installed"
  preflight
  if $undo; then
    step "Undo the cut-over: stop liquidsoap"
    say "The stream from this system stops. Then start the old source on the old system."
    typed CUTOVER "Stop liquidsoap?" || refuse "Not confirmed."
    mut dc stop liquidsoap || die "could not stop liquidsoap; see $LOG_REL"
    state_set 'del(.cutover_utc) | .cutover_undone_utc = $u' --arg u "$(utc_now)"
    say "liquidsoap is stopped. Start the old source now. Log: $LOG_REL"
    return 0
  fi
  cutover_done && {
    say "The cut-over was done at $(state_get .cutover_utc)."
    return 0
  }
  step "Cut-over preconditions"
  local bad=() body hs he n v stream
  api_get /readyz >/dev/null || bad+=("the backend is not ready")
  hs=$(fmt_time UTC '%Y-%m-%dT%H:00:00Z' "$(now)")
  he=$(fmt_time UTC '%Y-%m-%dT%H:00:00Z' "$(($(now) + 86400))")
  if body=$(api_get "/api/track-plan?from=$hs&to=$he"); then
    n=$(jq '[.items[] | select((.items // []) | length > 0)] | length' <<<"$body")
    ((n >= 24)) || bad+=("the plan covers $n of the next 24 hours")
  else
    bad+=("the plan could not be read")
  fi
  v=$(setting playout.emergency_playlist_id) || v=
  [[ -n $v && $v != null ]] || bad+=("no emergency playlist is set (playout.emergency_playlist_id)")
  # The stream output is whatever the panel says (the server may have
  # moved): only checked for being set and valid, then shown for the
  # operator to confirm.
  if stream=$(stream_settings); then
    v=$(jq -r '."stream.icecast_host" // "" | tostring' <<<"$stream")
    if [[ -z $v ]]; then
      bad+=("stream.icecast_host is not set")
    elif ! valid_host "$v"; then
      bad+=("stream.icecast_host '$v' is not a host name or IP address")
    elif [[ $v == icecast ]]; then
      bad+=("stream.icecast_host is 'icecast', the code default (the dev stack's server): set the server in the panel")
    fi
    v=$(jq -r '."stream.icecast_port" // "" | tostring' <<<"$stream")
    if [[ -z $v ]]; then
      bad+=("stream.icecast_port is not set")
    elif ! valid_port "$v"; then
      bad+=("stream.icecast_port '$v' is not a port (1-65535)")
    fi
    v=$(jq -r '."stream.mount" // "" | tostring' <<<"$stream")
    if [[ -z $v ]]; then
      bad+=("stream.mount is not set")
    elif ! valid_mount "$v"; then
      bad+=("stream.mount '$v' is not a mount (/ followed by letters, digits, or . _ ~ -)")
    fi
  else
    stream=
    bad+=("the stream settings could not be read")
  fi
  source_password_set || bad+=("the Icecast source password is not set: ICECAST_SOURCE_PASSWORD in .env (runbook 10.6)")
  if body=$(api_get /api/settings/secrets) &&
    [[ $(jq -r '.items[]? | select(.name == "ICECAST_SOURCE_PASSWORD") | .is_set' <<<"$body" 2>/dev/null) == false ]]; then
    bad+=("the backend reports ICECAST_SOURCE_PASSWORD as not set")
  fi
  if ((${#bad[@]})); then
    for v in "${bad[@]}"; do say "    not ready: $v"; done
    refuse "The cut-over is not started."
  fi
  say "    all preconditions met"
  say "The stream output (panel \"Stream output (Icecast)\"), used as it is:"
  stream_show "$stream"
  say "    source    $(stream_source_url "$stream")"
  say "    source password (ICECAST_SOURCE_PASSWORD): set"
  say "Check these values; change them in the panel first if they are wrong."
  say "Stop the old source on the old system first."
  typed CUTOVER "Start liquidsoap and stream to $(stream_source_url "$stream") with these settings now?" || refuse "Not confirmed."
  local infra
  infra=$(infra_now) || infra='{}'
  mut dc up -d --no-deps liquidsoap || die "liquidsoap did not start; see $LOG_REL"
  step "Waiting for the stream (60 s)"
  if ! wait_cutover 60; then
    say "Liquidsoap did not connect (control link, output, queued items, broadcast state) within 60 s."
    say "It keeps retrying. To go back: 'update.bat cutover --undo', then restart the old source. Log: $LOG_REL"
    exit 1
  fi
  state_set '.cutover_utc = $u | .applied += $n' --arg u "$(utc_now)" --argjson n "$infra"
  say "Cut-over done."
  # The settings as they are now (they may have been changed meanwhile).
  body=$(stream_settings) && stream=$body
  listen_hint "$stream"
  say "Listen and check by ear. Log: $LOG_REL"
}

wait_cutover() {
  $DRY_RUN && return 0
  local deadline body
  deadline=$(($(now) + $1))
  while :; do
    if body=$(api_get /api/playout/status) &&
      jq -e '.control_link.connected == true and .output.state == "connected" and ((.queued // []) | length) > 0' <<<"$body" >/dev/null &&
      body=$(api_get /api/broadcast/status) && [[ $(jq -r .state <<<"$body") == connected ]]; then
      return 0
    fi
    (($(now) >= deadline)) && return 1
    sleep_s 3
  done
}

random_secret() {
  local chars=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 out='' b
  for b in $(od -An -N48 -tu1 /dev/urandom); do
    out+=${chars:b%62:1}
  done
  printf '%s' "${out:0:32}"
}

# env_value <value>: as written to .env (single-quoted when not plain).
env_value() {
  if [[ $1 =~ ^[A-Za-z0-9._~@%+=:,/-]*$ ]]; then
    printf '%s' "$1"
  else
    printf "'%s'" "$1"
  fi
}

# write_env_file: .env from .env.example with the values in NEWENV.
declare -A NEWENV=()
write_env_file() {
  local line key
  (
    umask 077
    while IFS= read -r line || [[ -n $line ]]; do
      if [[ $line =~ ^([A-Za-z_][A-Za-z0-9_]*)= ]]; then
        key=${BASH_REMATCH[1]}
        if [[ -v NEWENV[$key] ]]; then
          printf '%s=%s\n' "$key" "$(env_value "${NEWENV[$key]}")"
          continue
        fi
      fi
      printf '%s\n' "$line"
    done <"$ROOT/.env.example" >"$ENV_FILE.tmp"
  )
  mv "$ENV_FILE.tmp" "$ENV_FILE"
}

prompt_secret() {
  local v=
  while :; do
    printf '%s: ' "$1" >&3
    if [[ -t 0 ]]; then
      IFS= read -rs v || die "no value for $1"
      printf '\n' >&3
    else
      IFS= read -r v || die "no value for $1"
    fi
    if [[ -z $v ]]; then
      say "    $1 may not be empty"
      continue
    fi
    if [[ $v == *"'"* ]]; then
      say "    $1 may not contain a single quote"
      continue
    fi
    break
  done
  NEWENV[$1]=$v
}

# ask_valid <label> <current> <check function> <what is valid>: a value,
# the current one on an empty answer (or at the end of the input).
ask_valid() {
  local v
  while :; do
    printf '    %s [%s]: ' "$1" "$2" >&3
    IFS= read -r v || {
      printf '%s' "$2"
      return 0
    }
    v=${v//[[:space:]]/}
    [[ -n $v ]] || v=$2
    if "$3" "$v"; then
      log "stream setting $1 = $v"
      printf '%s' "$v"
      return 0
    fi
    printf '    must be %s\n' "$4" >&3
  done
}

# stream_edit <settings json>: asks for host, port, mount, and TLS; prints
# the settings with the answers.
stream_edit() {
  local s=$1 h p m t
  h=$(ask_valid "Icecast host" "$(jq -r '."stream.icecast_host" // ""' <<<"$s")" valid_host "a host name or an IP address")
  p=$(ask_valid "Icecast port" "$(jq -r '."stream.icecast_port" // ""' <<<"$s")" valid_port "a number from 1 to 65535")
  m=$(ask_valid "Mount" "$(jq -r '."stream.mount" // ""' <<<"$s")" valid_mount "/ followed by letters, digits, or . _ ~ -")
  t=$(ask_valid "TLS (true/false)" "$(jq -r '."stream.icecast_tls" // false' <<<"$s")" valid_bool "true or false")
  case ${t,,} in
    true | yes | y | on) t=true ;;
    *) t=false ;;
  esac
  # Only at the end of the input with an invalid proposal: keep it as it was.
  if ! valid_host "$h" || ! valid_port "$p" || ! valid_mount "$m"; then
    printf '%s' "$s"
    return 0
  fi
  jq -c --arg h "$h" --argjson p "$((10#$p))" --arg m "$m" --argjson t "$t" \
    '. + {"stream.icecast_host": $h, "stream.icecast_port": $p, "stream.mount": $m, "stream.icecast_tls": $t}' <<<"$s"
}

# first_run_stream: proposes config/stream-defaults.json (with the dry-run
# overlay) as the stream settings. The operator saves them, edits the
# server first, or leaves them for the panel; --yes saves the defaults.
first_run_stream() {
  local s ans
  if ! s=$(stream_defaults); then
    warn "config/stream-defaults.json is missing or not a JSON object; set the stream in the panel under \"Stream output (Icecast)\" before the cut-over"
    return 0
  fi
  while :; do
    say "Proposed stream output (config/stream-defaults.json; panel settings, changeable at any time):"
    jq -r 'to_entries[] | "    \(.key) = \(.value)"' <<<"$s" >&3
    if $YES; then
      say "Save these stream settings? yes (--yes)"
      ans=y
    elif $DRY_RUN; then
      say "    [dry-run] would ask: Save these stream settings?"
      ans=y
    else
      printf 'Save these stream settings? [y = save, e = edit server/port/mount/TLS, n = not now] ' >&3
      IFS= read -r ans || ans=n
      log "save stream settings -> $ans"
    fi
    case ${ans,,} in
      y | yes) break ;;
      e | edit) s=$(stream_edit "$s") ;;
      *)
        say "    not saved; set them in the panel under \"Stream output (Icecast)\" before the cut-over"
        return 0
        ;;
    esac
  done
  if $DRY_RUN; then
    say "    [dry-run] PATCH /api/settings"
  else
    api_patch_settings "$s" || first_run_fail "stream settings (PATCH /api/settings)"
    say "    saved"
  fi
}

first_run_fail() {
  state_set '.last_result = "failed" | .first_run_failed_step = $s' --arg s "$1"
  say ""
  say "The first run failed at: $1. Nothing is rolled back; run update.bat (or install.bat) again after the cause is fixed."
  say "Send the log $LOG_REL to the developer."
  exit 1
}

# shellcheck disable=SC2120 # called as "cmd_$CMD" "$@" from main
cmd_first_run() {
  local media_root=
  while (($#)); do
    case $1 in
      --media-root) media_root=${2:?--media-root needs a path}; shift 2 ;;
      *) die "first-run takes only --media-root <path>" ;;
    esac
  done
  if installed; then
    die "a release is installed already ($(state_get .current.backend_tag)); use update"
  fi
  step "First run"
  preflight_docker
  if [[ ! -f $STATE_FILE ]] && docker volume inspect "${PROJECT}_pgdata" >/dev/null 2>&5; then
    die "the database volume ${PROJECT}_pgdata exists but state.json does not: data without state needs a manual decision"
  fi
  local grafana_pw=
  if [[ ! -f $ENV_FILE ]]; then
    step "Writing .env"
    if $DRY_RUN; then
      say "    [dry-run] .env from .env.example with generated secrets and prompted values"
      die "--dry-run stops here: there is no .env yet"
    fi
    NEWENV[POSTGRES_PASSWORD]=$(random_secret)
    NEWENV[LIQUIDSOAP_CONTROL_PASSWORD]=$(random_secret)
    NEWENV[GRAFANA_ADMIN_PASSWORD]=$(random_secret)
    NEWENV[GRAFANA_DB_PASSWORD]=$(random_secret)
    grafana_pw=${NEWENV[GRAFANA_ADMIN_PASSWORD]}
    say "Enter the registry and stream credentials (nothing is shown or logged)."
    prompt_secret GHCR_USER
    prompt_secret GHCR_READ_TOKEN
    prompt_secret ICECAST_SOURCE_PASSWORD
    [[ -n $media_root ]] && NEWENV[MEDIA_ROOT]=$media_root
    write_env_file
    say "    .env written (mode 600)"
  elif [[ -n $media_root ]]; then
    load_env
    if [[ $(envv MEDIA_ROOT) != "$media_root" ]]; then
      NEWENV=()
      read_kv "$ENV_FILE" NEWENV
      NEWENV[MEDIA_ROOT]=$media_root
      $DRY_RUN || write_env_file
    fi
  fi
  load_env
  check_env_vars
  [[ -f $NETWORK_ENV ]] || die "runtime/network.env is missing; radio-network.service writes it (install.bat, D4)"
  [[ -d $(envv MEDIA_ROOT) ]] || die "the media folder $(envv MEDIA_ROOT) does not exist"
  [[ -d $(envv PLAYOUT_JOURNAL_ROOT) ]] || die "the journal folder $(envv PLAYOUT_JOURNAL_ROOT) does not exist (setup-distro.sh creates it)"
  state_init

  declare -A REL=()
  read_kv "$RELEASE_FILE" REL
  T_BTAG=${REL[BACKEND_TAG]:-}
  T_BDIG=${REL[BACKEND_DIGEST]:-}
  T_FTAG=${REL[FRONTEND_TAG]:-}
  T_FDIG=${REL[FRONTEND_DIGEST]:-}
  [[ -n $T_BDIG && -n $T_FDIG ]] || die "release.env has no digest for $T_BTAG/$T_FTAG; a release PR must set them"
  TARGET_LABEL=$(release_label "$T_BTAG" "$T_FTAG")
  KIND=first-run
  step "Release check: $TARGET_LABEL"
  local t d min_backend
  for t in "$T_BTAG" "$T_FTAG"; do
    if ! is_semver "$t" || ver_lt "$t" 1.0.0; then
      die "release.env: '$t' is not a release >= 1.0.0"
    fi
  done
  [[ $(major_minor "$T_BTAG") == "$(major_minor "$T_FTAG")" ]] || die "release.env: backend and frontend differ in MAJOR.MINOR"
  min_backend=$(script_min_backend "$SCRIPT_FILE") || die "config/liquidsoap/radio.liq has no min-backend header"
  ver_lt "$T_BTAG" "$min_backend" && die "backend $T_BTAG is below the script's min-backend $min_backend"
  registry_login
  d=$(resolve_digest "$BACKEND_IMAGE" "$T_BTAG") || d=
  [[ $d == "$T_BDIG" ]] || die "$BACKEND_IMAGE:$T_BTAG is not $T_BDIG in the registry"
  d=$(resolve_digest "$FRONTEND_IMAGE" "$T_FTAG") || d=
  [[ $d == "$T_FDIG" ]] || die "$FRONTEND_IMAGE:$T_FTAG is not $T_FDIG in the registry"

  write_app_env "$APPLIED_ENV" "$T_BTAG" "$T_BDIG" "$T_FTAG" "$T_FDIG"
  record_target
  step "Pulling images"
  mut dc pull -q || first_run_fail "pull"
  step "Starting the stack (liquidsoap stays stopped until the cut-over)"
  mut dc up -d --wait db || first_run_fail "db"
  local rc=0
  mut dc run --rm --no-deps -T migrate </dev/null || rc=$?
  ((rc == 0)) || first_run_fail "migrate (exit $rc)"
  mut dc up -d --no-deps backend || first_run_fail "backend"
  health_gate ready || first_run_fail "backend health"
  mut dc up -d --no-deps frontend || first_run_fail "frontend"
  wait_healthy frontend 60 || first_run_fail "frontend health"
  apply_monitoring

  step "Stream settings"
  first_run_stream

  step "Backups"
  enable_backup_timer

  local infra
  infra=$(infra_now) || infra='{}'
  DB_SCHEMA_VERSION=0 DB_MIN_APP=$(read_min_app 2>/dev/null || echo 1.0.0)
  history_add ok false "$DB_MIN_APP"
  local bi fimg
  bi=$(image_info "$BACKEND_IMAGE:$T_BTAG@$T_BDIG")
  fimg=$(image_info "$FRONTEND_IMAGE:$T_FTAG@$T_FDIG")
  state_set '.current = {backend_tag: $bt, backend_digest: $bd, frontend_tag: $ft, frontend_digest: $fd,
        backend_image_id: ($bi | split(" ")[0]), frontend_image_id: ($fimg | split(" ")[0]),
        platform: ($bi | split(" ")[1] // null)}
    | .applied = ($n + {config_sha256: $h}) | .pending_maintenance = [] | .last_update_utc = $utc
    | .last_result = "ok" | del(.target) | del(.first_run_failed_step)' \
    --arg bt "$T_BTAG" --arg bd "$T_BDIG" --arg ft "$T_FTAG" --arg fd "$T_FDIG" \
    --arg bi "$bi" --arg fimg "$fimg" --argjson n "$infra" --argjson h "$CONFIG_HASHES" --arg utc "$(utc_now)"
  say ""
  say "First run done: $TARGET_LABEL is running; liquidsoap waits for the cut-over ('update.bat cutover')."
  say "Panel: http://127.0.0.1:$(envv PANEL_PORT 8080)"
  # Shown once, when the first run completes (also after a failed first
  # run that had already generated it).
  grafana_pw=$(envv GRAFANA_ADMIN_PASSWORD)
  if [[ -n $grafana_pw ]] && monitoring_enabled; then
    say "Grafana: http://127.0.0.1:$(envv GRAFANA_PORT 3000), user admin, password (shown once, not logged):"
    printf '    %s\n' "$grafana_pw" >&3
  fi
  say "Log: $LOG_REL"
}

# enable_backup_timer: plan 6.8 step 7. The units (install/systemd/) are
# installed and enabled as root by setup-distro.sh through
# install/systemd/install-units.sh (D4); radioctl runs as radio, so it only
# checks them here, then runs the first backup. A failed first backup is a
# warning: the stack runs, and status shows it.
enable_backup_timer() {
  local u
  if ! command -v systemctl >/dev/null 2>&1; then
    say "    systemctl not found (not a systemd host): the backup timers are not checked"
  else
    for u in radio-backup.timer radio-restore-drill.timer; do
      if systemctl is-enabled --quiet "$u" >&5 2>&5; then
        say "    $u enabled"
      else
        warn "$u is not enabled; as root run install/systemd/install-units.sh (install.bat does it)"
      fi
    done
  fi
  run_backup || warn "the first backup failed; see $LOG_REL ('update.bat status' shows the last backup)"
}

# report_backup_failure: a failed daily backup is shown by the next update.
report_backup_failure() {
  [[ $(state_get '.last_backup.result // empty') == failed ]] || return 0
  warn "the last daily backup failed at $(state_get .last_backup.utc): $(state_get '.last_backup.error // "unknown"'); see $(state_get '.last_backup.log // "logs/"')"
}

cmd_status() {
  load_env || die ".env is missing: this machine has no first run yet"
  local body
  say "Release"
  if installed; then
    say "    running   $(release_label "$(state_get .current.backend_tag)" "$(state_get .current.frontend_tag)")"
    [[ -n $(state_get '.previous.backend_tag // empty') ]] &&
      say "    previous  $(release_label "$(state_get .previous.backend_tag)" "$(state_get .previous.frontend_tag)")"
  else
    say "    none installed"
  fi
  declare -A REL=()
  read_kv "$RELEASE_FILE" REL
  say "    release.env $(release_label "${REL[BACKEND_TAG]:-?}" "${REL[FRONTEND_TAG]:-?}")"
  say "    last result $(state_get '.last_result // "none"') $(state_get '.last_update_utc // ""')"
  [[ -n $(state_get '.target.backend_tag // empty') ]] &&
    say "    an update to $(state_get .target.backend_tag) did not finish"
  say "    cut-over    $(state_get '.cutover_utc // "not yet"')"

  say "Containers"
  if [[ -f $APPLIED_ENV && -f $NETWORK_ENV ]] && body=$(dc ps --all --format json 2>&5); then
    jq -rs 'flatten | .[] | "    \(.Service | . + (" " * (14 - length))) \(.State)\(if (.Health // "") != "" then " (" + .Health + ")" else "" end)"' <<<"$body" >&3 || true
  else
    say "    unknown (compose did not answer)"
  fi
  local boot
  boot=$(find "$LOG_DIR" -maxdepth 1 -name 'boot-*.log' 2>/dev/null | LC_ALL=C sort | tail -n 1) || true
  if [[ -n $boot ]]; then
    say "    boot check: $(tail -n 1 "$boot")"
  fi
  if [[ -f $NETWORK_ENV ]]; then
    declare -A NET=()
    read_kv "$NETWORK_ENV" NET
    say "    network: live voice on ${NET[LIVE_PUBLIC_IPS]:-?}:8189/udp (bound to ${NET[LIVE_UDP_BIND]:-?})"
  fi

  say "Air"
  if body=$(api_get /api/broadcast/status); then
    say "    broadcast $(jq -r '.state' <<<"$body")"
  else
    say "    broadcast unknown (backend not reachable)"
  fi
  if body=$(api_get /api/status/live); then
    say "    live on air: $(jq -r '.on_air' <<<"$body")"
  fi
  if body=$(api_get /api/playout/status); then
    say "    control link $(jq -r '.control_link.connected' <<<"$body"), output $(jq -r '.output.state // "unknown"' <<<"$body"), queued $(jq '(.queued // []) | length' <<<"$body")"
  fi

  say "Pending maintenance"
  local p line
  p=$(state_get '.pending_maintenance // [] | .[]')
  if [[ -z $p ]]; then
    say "    none"
  else
    while IFS= read -r line; do say "    $line"; done <<<"$p"
  fi

  status_backups

  say "Disk"
  local path pct gb
  for path in "$ROOT" "$(envv BACKUP_ROOT)" "$(envv MEDIA_ROOT)"; do
    [[ -e $path ]] || continue
    line=$(df -Pk "$path" 2>/dev/null | tail -n 1) || continue
    pct=$(awk '{gsub("%", "", $5); print $5}' <<<"$line")
    gb=$(awk '{printf "%.1f", $4 / 1048576}' <<<"$line")
    if ((100 - pct < 15)); then
      say "    LOW SPACE: $path ($((100 - pct))% free, $gb GB)"
    else
      say "    $path: $((100 - pct))% free, $gb GB"
    fi
  done

  say "Media"
  local media
  media=$(envv MEDIA_ROOT)
  if [[ ! -d $media ]]; then
    say "    MISSING: $media is not mounted (is the Windows drive connected?)"
  elif [[ ! -w $media ]]; then
    say "    NOT WRITABLE: $media (group radio-media write is needed for transcodes)"
  else
    say "    $media ok"
  fi
}

# age_s <UTC ISO time>: seconds since then (empty if unparsable).
age_s() {
  local t
  t=$(jq -rn --arg t "$1" '$t | fromdateiso8601' 2>/dev/null) || return 0
  printf '%s' "$(($(now) - t))"
}

status_backups() {
  local res age w
  say "Backups"
  res=$(state_get '.last_backup.result // empty')
  case $res in
    ok)
      say "    last daily backup $(state_get .last_backup.utc) ok: $(basename "$(state_get .last_backup.dump)"), journal $(state_get '.last_backup.journal // "?"'), Windows copy $(state_get '.last_backup.windows_copy // "?"')"
      while IFS= read -r w; do
        [[ -n $w ]] && say "      warning: $w"
      done < <(state_get '.last_backup.warnings // [] | .[]')
      ;;
    failed)
      say "    last daily backup FAILED at $(state_get .last_backup.utc): $(state_get '.last_backup.error // "unknown"') (log $(state_get '.last_backup.log // "?"'))"
      say "    last successful backup $(state_get '.last_backup_utc // "none"')"
      ;;
    *) say "    last daily backup $(state_get '.last_backup_utc // "none"')" ;;
  esac
  if [[ -n $(state_get '.last_backup_utc // empty') ]]; then
    age=$(age_s "$(state_get .last_backup_utc)")
    if [[ -n $age ]] && ((age > 26 * 3600)); then
      say "    OVERDUE: no successful daily backup for $((age / 3600)) hours (radio-backup.timer runs it at 04:30)"
    fi
  fi
  say "    last update dump $(state_get '.last_dump // "none"')"
  res=$(state_get '.last_drill.result // empty')
  case $res in
    ok) say "    last restore drill $(state_get .last_drill.utc) ok: $(basename "$(state_get .last_drill.dump)"), schema version $(state_get .last_drill.schema_version)" ;;
    failed) say "    last restore drill FAILED at $(state_get .last_drill.utc): $(state_get '.last_drill.error // "unknown"') (log $(state_get '.last_drill.log // "?"'))" ;;
    *) say "    last restore drill never (monthly: radio-restore-drill.timer, or 'update.bat restore-drill')" ;;
  esac
  if [[ $res == ok ]]; then
    age=$(age_s "$(state_get .last_drill.utc)")
    if [[ -n $age ]] && ((age > 35 * 86400)); then
      say "    DUE: the last successful restore drill is $((age / 86400)) days old"
    fi
  fi
}

cmd_backup() {
  (($# == 0)) || die "backup takes no arguments"
  load_env || die ".env is missing: this machine has no first run yet"
  check_env_vars
  [[ -f $APPLIED_ENV && -f $NETWORK_ENV ]] ||
    die "runtime/applied.env or runtime/network.env is missing: nothing is installed yet"
  run_backup || exit 1
}

cmd_restore_drill() {
  (($# <= 1)) || die "restore-drill takes at most one dump"
  load_env || die ".env is missing: this machine has no first run yet"
  check_env_vars
  [[ -f $APPLIED_ENV && -f $NETWORK_ENV ]] ||
    die "runtime/applied.env or runtime/network.env is missing: nothing is installed yet"
  [[ $(envv POSTGRES_DB) != "$DRILL_DB" ]] ||
    die "POSTGRES_DB is $DRILL_DB, the scratch database of the drill; refused"
  local dump
  if (($#)); then
    dump=$(find_dump "$1") || die "dump not found: $1"
  elif ! dump=$(newest_daily_dump); then
    drill_failed "" "no daily dump in $(envv BACKUP_ROOT)/daily (run 'update.bat backup' first)"
  fi
  step "Restore drill: $(basename "$dump") (taken $(dump_time "$dump"))"
  say "    into the scratch database $DRILL_DB; the production database $(envv POSTGRES_DB) is not touched"
  if $DRY_RUN; then
    say "    [dry-run] DROP DATABASE IF EXISTS $DRILL_DB; CREATE DATABASE $DRILL_DB"
    say "    [dry-run] pg_restore -d $DRILL_DB < $dump"
    say "    [dry-run] check schema_migrations and the rows of ${DRILL_TABLES[*]}"
    say "    [dry-run] DROP DATABASE $DRILL_DB"
    return 0
  fi
  wait_healthy db 120 || drill_failed "$dump" "the database container (db) is not healthy"
  local dropped=true
  drill_run "$dump" || true
  log "+ DROP DATABASE IF EXISTS $DRILL_DB"
  if drill_sql postgres "DROP DATABASE IF EXISTS $DRILL_DB WITH (FORCE)" >&5; then
    say "    scratch database $DRILL_DB dropped"
  else
    dropped=false
    warn "the scratch database $DRILL_DB could not be dropped; see $LOG_REL"
  fi
  [[ -z $DRILL_ERROR ]] || drill_failed "$dump" "$DRILL_ERROR"
  state_set '.last_drill = {utc: $u, result: "ok", dump: $d, schema_version: ($v | tonumber),
      counts: $c, scratch_dropped: $dr, log: $log}' \
    --arg u "$(utc_now)" --arg d "$dump" --arg v "$DRILL_VERSION" --argjson c "$DRILL_COUNTS" \
    --argjson dr "$dropped" --arg log "$LOG_REL"
  say "Restore drill passed: $(basename "$dump") restores, schema version $DRILL_VERSION. Log: $LOG_REL"
}

# drill_failed <dump> <reason>: records it and exits 1.
drill_failed() {
  state_set '.last_drill = {utc: $u, result: "failed", dump: (if $d == "" then null else $d end), error: $e, log: $log}' \
    --arg u "$(utc_now)" --arg d "$1" --arg e "$2" --arg log "$LOG_REL"
  printf 'ERROR: restore drill FAILED: %s. The production database was not touched. Send the log %s to the developer.\n' "$2" "$LOG_REL" >&4
  log "ERROR: restore drill failed: $2"
  exit 1
}

cmd_logs() {
  if (($# == 0)); then
    local last
    last=$(find "$LOG_DIR" -maxdepth 1 -name '*.log' ! -name 'boot-*' ! -name 'network-*' ! -name 'keepalive.log' 2>/dev/null | LC_ALL=C sort | tail -n 1) || true
    [[ -n $last ]] || die "no run log yet"
    printf '%s\n' "$last"
    tail -n 100 "$last"
    return 0
  fi
  load_env || die ".env is missing"
  dc logs --tail 200 "$@"
}

cmd_compose() {
  load_env || die ".env is missing"
  [[ -f $APPLIED_ENV ]] || die "runtime/applied.env is missing: nothing is installed"
  dc "$@"
}

# ---------------------------------------------------------------------------
# Boot units (plan D4 6.3 step 6, 6.5)

HOST_ENV=${RADIOCTL_HOST_ENV:-/etc/radio-atlantida/host.env}

# vm_address: the IPv4 address of the VM's interface (NAT mode); waits up
# to RADIOCTL_NET_WAIT seconds, because WSL may configure eth0 a moment
# after systemd starts.
vm_address() {
  local dev=${RADIOCTL_NET_DEV:-eth0} wait=${RADIOCTL_NET_WAIT:-30} deadline addr
  deadline=$(($(now) + wait))
  while :; do
    addr=$(ip -4 -o addr show dev "$dev" 2>&5 | awk '{ split($4, a, "/"); print a[1]; exit }') || addr=
    if [[ $addr =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      printf '%s' "$addr"
      return 0
    fi
    (($(now) >= deadline)) && return 1
    sleep_s 2
  done
}

# backend_network: "<LIVE_PUBLIC_IPS> <host ip of 8189/udp>" of the backend
# container as it was created; fails when there is no backend container.
backend_network() {
  local cid ips bind
  cid=$(dc ps -q backend 2>&5) || return 1
  [[ -n $cid ]] || return 1
  ips=$(docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$cid" 2>&5 | sed -n 's/^LIVE_PUBLIC_IPS=//p') || return 1
  bind=$(docker inspect --format '{{range $p, $b := .HostConfig.PortBindings}}{{if eq $p "8189/udp"}}{{range $b}}{{.HostIp}}{{end}}{{end}}{{end}}' "$cid" 2>&5) || return 1
  printf '%s %s' "$ips" "$bind"
}

# cmd_network: plan 6.5. NAT mode (Windows 10): LIVE_UDP_BIND=0.0.0.0 and
# LIVE_PUBLIC_IPS=<eth0 address>; mirrored mode (Windows 11 22H2+): both
# 127.0.0.1. Writes runtime/network.env when it differs, and recreates the
# backend only when the running container has other values.
cmd_network() {
  local mode=
  while (($#)); do
    case $1 in
      --mode) mode=${2:?--mode needs nat or mirrored}; shift 2 ;;
      *) die "network takes only --mode nat|mirrored" ;;
    esac
  done
  if [[ -z $mode && -f $HOST_ENV ]]; then
    declare -A HOST=()
    read_kv "$HOST_ENV" HOST
    mode=${HOST[RADIO_NETWORK_MODE]:-}
  fi
  local bind ips
  case $mode in
    nat)
      bind=0.0.0.0
      ips=$(vm_address) || die "no IPv4 address on ${RADIOCTL_NET_DEV:-eth0} after ${RADIOCTL_NET_WAIT:-30}s"
      ;;
    mirrored) bind=127.0.0.1 ips=127.0.0.1 ;;
    '') die "no network mode: $HOST_ENV has no RADIO_NETWORK_MODE (setup-distro.sh writes it) and no --mode was given" ;;
    *) die "unknown network mode '$mode' (nat or mirrored)" ;;
  esac
  step "Network values ($mode mode): LIVE_UDP_BIND=$bind LIVE_PUBLIC_IPS=$ips"
  local content
  content="# Written by radioctl network ($mode mode); the live voice port (plan 6.5).
LIVE_UDP_BIND=$bind
LIVE_PUBLIC_IPS=$ips"
  if [[ -f $NETWORK_ENV ]] && [[ $(grep -v '^#' "$NETWORK_ENV") == "$(grep -v '^#' <<<"$content")" ]]; then
    say "    runtime/network.env unchanged"
  elif $DRY_RUN; then
    say "    [dry-run] write runtime/network.env"
  else
    mkdir -p "$RUNTIME_DIR"
    printf '%s\n' "$content" >"$NETWORK_ENV.tmp"
    mv "$NETWORK_ENV.tmp" "$NETWORK_ENV"
    say "    runtime/network.env written"
  fi

  if [[ ! -f $APPLIED_ENV ]] || ! load_env; then
    say "    no release installed yet: nothing to recreate"
    return 0
  fi
  local running
  if ! running=$(backend_network); then
    say "    no backend container: nothing to recreate"
    return 0
  fi
  if [[ $running == "$ips $bind" ]]; then
    say "    the backend runs with these values"
    return 0
  fi
  say "    the backend was created with LIVE_PUBLIC_IPS=${running% *} on ${running#* }; recreating it"
  mut dc up -d --no-deps backend || die "recreating the backend failed; see $LOG_REL"
  say "    backend recreated"
}

# cmd_boot_check: plan 6.3 step 6 and the D4 reboot test. Waits up to
# RADIOCTL_BOOT_WAIT (600) seconds for every service that should run to be
# healthy (or running, for loki, which has no health check): db, backend,
# frontend, loki, alloy, grafana when monitoring is on, liquidsoap after the
# cut-over. Records the VM uptime at that moment against the 5-minute
# target. Only reports: always exits 0; the last log line is the result.
cmd_boot_check() {
  local wait=${RADIOCTL_BOOT_WAIT:-600} target=300 u0 t0 elapsed s st bad
  u0=${RADIOCTL_UPTIME0:-$(cut -d' ' -f1 /proc/uptime 2>/dev/null || echo 0)}
  u0=${u0%.*}
  t0=$(now)
  if ! load_env || [[ ! -f $APPLIED_ENV || ! -f $NETWORK_ENV ]]; then
    say "boot check: skipped, no release installed yet"
    return 0
  fi
  local services=(db backend frontend loki alloy)
  monitoring_enabled && services+=(grafana)
  cutover_done && services+=(liquidsoap)
  say "boot check: waiting up to ${wait}s for ${services[*]} (VM uptime ${u0}s)"
  while :; do
    bad=()
    for s in "${services[@]}"; do
      st=$(container_status "$s") || st=missing
      [[ $st == healthy || $st == running ]] || bad+=("$s=$st")
    done
    elapsed=$(($(now) - t0))
    if ((${#bad[@]} == 0)); then
      if ((u0 + elapsed <= target)); then
        say "ok: stack healthy at VM uptime $((u0 + elapsed))s (target ${target}s)"
      else
        say "LATE: stack healthy at VM uptime $((u0 + elapsed))s, over the ${target}s target"
      fi
      return 0
    fi
    if ((elapsed >= wait)); then
      say "FAILED: not healthy after ${elapsed}s (VM uptime $((u0 + elapsed))s): ${bad[*]}"
      return 0
    fi
    sleep_s 5
  done
}

main() {
  local args=() a
  while (($#)); do
    a=$1
    shift
    case $a in
      --dry-run) DRY_RUN=true ;;
      --yes | -y) YES=true ;;
      --no-wait) NO_WAIT=true ;;
      --no-fetch) NO_FETCH=true ;;
      -h | --help) usage; exit 0 ;;
      compose | logs)
        if ((${#args[@]} == 0)); then
          args+=("$a" "$@")
          break
        fi
        args+=("$a")
        ;;
      *) args+=("$a") ;;
    esac
  done
  set -- "${args[@]}"
  # update.bat <backendTag> [<frontendTag>] (plan 7.2): a bare tag is an update.
  if (($#)) && is_semver "$1"; then
    set -- update "$@"
  fi
  CMD=${1:-update}
  (($#)) && shift
  case $CMD in
    status) cmd_status "$@" ;;
    logs) cmd_logs "$@" ;;
    compose) cmd_compose "$@" ;;
    boot-check)
      open_log boot
      cmd_boot_check "$@"
      ;;
    network)
      mkdir -p "$LOG_DIR"
      open_log network
      take_lock
      $DRY_RUN && say "DRY RUN: nothing is changed."
      cmd_network "$@"
      ;;
    backup | restore-drill)
      # The log first: a timer run that cannot take the lock (an update
      # runs) leaves its reason in a run log too.
      mkdir -p "$LOG_DIR"
      open_log "$CMD"
      take_lock
      $DRY_RUN && say "DRY RUN: nothing is changed."
      "cmd_${CMD//-/_}" "$@"
      ;;
    update | rollback | restore | maintenance | cutover | first-run)
      mkdir -p "$LOG_DIR"
      take_lock
      open_log "$CMD"
      $DRY_RUN && say "DRY RUN: nothing is changed."
      "cmd_${CMD//-/_}" "$@"
      ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
