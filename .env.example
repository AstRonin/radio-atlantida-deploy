# Template of the per-machine .env (deploy-init-plan.md D1). The real .env is
# written by `radioctl first-run` (secrets generated or prompted) and is never
# committed. Values here are placeholders.
#
# Not in this file:
# - fixed in docker-compose.yml (facts of the service names and port mapping):
#   HTTP_ADDR, LIVE_UDP_ADDR, LOKI_URL, BACKEND_CALLBACK_URL,
#   BACKEND_EMERGENCY_URL, BACKEND_OUTPUT_URL, every image pin;
# - the stream server (host, port, mount, TLS, format): backend settings,
#   edited in the panel under "Stream output (Icecast)";
# - BACKEND_TAG/DIGEST, FRONTEND_TAG/DIGEST, GRAFANA_URL: written by radioctl
#   into runtime/applied.env;
# - LIVE_UDP_BIND, LIVE_PUBLIC_IPS: written by radioctl and
#   radio-network.service into runtime/network.env.

# --- Registry (GitHub Container Registry) ---
# Account that owns the read token.
GHCR_USER=change-me
# Fine-grained token, read-only on the radio-atlantida-* packages (11.10).
# Record its expiry date in the runbook.
GHCR_READ_TOKEN=change-me

# --- Host paths (Linux paths inside the radio-atlantida distribution) ---
# The station's Windows media folder as WSL sees it; written by the installer
# from the folder the operator chooses (6.6). Must exist: the compose file
# does not create it.
MEDIA_ROOT=/mnt/d/RadioAtlantida/media
# Playout journal (ext4). Written by liquidsoap, read by backend and alloy.
PLAYOUT_JOURNAL_ROOT=/srv/radio/journal
# Database dumps and journal copies (ext4).
BACKUP_ROOT=/srv/radio/backups
# Copy of the backups on the Windows drive; empty disables the copy (D6).
BACKUP_WINDOWS_COPY=/mnt/c/RadioAtlantida/backups

# --- Database ---
POSTGRES_USER=radio
# Letters and digits only: it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=changeme
POSTGRES_DB=radio

# --- Stream and control secrets ---
# Source password of the external Icecast server; entered by hand, never
# generated.
ICECAST_SOURCE_PASSWORD=change-me
# Liquidsoap telnet control and harbor credentials (internal only).
LIQUIDSOAP_CONTROL_USER=source
LIQUIDSOAP_CONTROL_PASSWORD=change-me

# --- Panel ---
# Always published on 127.0.0.1.
PANEL_PORT=8080

# --- Monitoring (11.11) ---
# true: radioctl starts the compose profile "monitoring" (grafana-role,
# grafana). Loki and Alloy are core services and always run.
MONITORING_ENABLED=true
# Always published on 127.0.0.1.
GRAFANA_PORT=3000
# Applied only when the grafana-data volume is created; later changes use
# `grafana cli admin reset-admin-password` (runbook).
GRAFANA_ADMIN_PASSWORD=change-me
# Password of the read-only database role grafana_ro (letters and digits).
GRAFANA_DB_PASSWORD=changeme

# --- Backups (D6) ---
BACKUP_DAILY_KEEP=14
BACKUP_UPDATE_KEEP=14
BACKUP_BOUNDARY_KEEP=3
