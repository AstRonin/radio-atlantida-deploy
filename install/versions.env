# Pinned host versions for install.bat / setup-distro.sh (deploy-init-plan.md
# D4). Placeholders: filled in D4 and checked by CI (D7, 9.1 item 7). A change
# is applied by running install.bat in a maintenance window.

# Ubuntu 24.04 LTS WSL root file system (amd64), imported with `wsl --import`.
UBUNTU_ROOTFS_URL=
# SHA-256 of the file at UBUNTU_ROOTFS_URL; the installer refuses a mismatch.
UBUNTU_ROOTFS_SHA256=

# Fingerprint of Docker's apt repository signing key; the installer refuses
# another key.
DOCKER_APT_KEY_FINGERPRINT=
# apt versions from Docker's repository for Ubuntu 24.04 (`apt-cache madison`),
# held with `apt-mark hold`.
DOCKER_CE_VERSION=
CONTAINERD_VERSION=
DOCKER_COMPOSE_PLUGIN_VERSION=

# Minimum Store WSL version (`wsl --version`); older ones run `wsl --update`.
WSL_MIN_VERSION=
