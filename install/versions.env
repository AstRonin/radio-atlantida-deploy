# Pinned host versions for install.bat / setup-distro.sh (deploy-init-plan.md
# D4). Checked by CI (D7, 9.1 item 7). A change is applied by running
# install.bat in a maintenance window. Read by install.ps1, setup-distro.sh,
# and radioctl (Docker and Compose must match). KEY=VALUE only, no quotes.
#
# Values checked on 2026-11-13.

# Ubuntu 24.04 LTS WSL root file system (amd64), imported with `wsl --import`.
# The dated release folder of Canonical's WSL images is never rewritten
# (unlike current/), so the URL and the checksum stay valid. This is the
# classic rootfs tarball without the first-run user dialog of the newer
# .wsl format; setup-distro.sh brings its packages up to date once.
# Alternative if Canonical removes it: releases.ubuntu.com/noble/
# ubuntu-24.04.5-wsl-amd64.wsl (sha256 bb415d82...6039e; verify on Windows
# that `wsl --import` of a .wsl file shows no first-run dialog).
UBUNTU_ROOTFS_URL=https://cloud-images.ubuntu.com/wsl/releases/24.04/20240423/ubuntu-noble-wsl-amd64-24.04lts.rootfs.tar.gz
# SHA-256 of the file at UBUNTU_ROOTFS_URL (from the folder's SHA256SUMS);
# the installer refuses a mismatch.
UBUNTU_ROOTFS_SHA256=2a790896740b14d637dbdc583cce1ba081ac53b9e9cdb46dc09a2f73abbd9934

# Fingerprint of Docker's apt repository signing key
# (https://download.docker.com/linux/ubuntu/gpg); setup-distro.sh refuses
# another key.
DOCKER_APT_KEY_FINGERPRINT=9DC858229FC7DD38854AE2D88D81803C0EBFCD88
# apt versions from Docker's repository for Ubuntu 24.04 noble
# (`apt-cache madison <package>`), installed with an apt pin and held with
# `apt-mark hold`. DOCKER_CE_VERSION is used for docker-ce and docker-ce-cli.
# radioctl compares the running engine (29.9.3) and Compose (5.7.1) with
# these values.
DOCKER_CE_VERSION=5:29.9.3-1~ubuntu.24.04~noble
CONTAINERD_VERSION=2.4.2-4~ubuntu.24.04~noble
DOCKER_COMPOSE_PLUGIN_VERSION=5.7.1-1~ubuntu.24.04~noble
# buildx: radioctl resolves manifest list digests with
# `docker buildx imagetools inspect`.
DOCKER_BUILDX_PLUGIN_VERSION=0.39.0-1~ubuntu.24.04~noble

# Minimum Store WSL version (`wsl --version`); older ones run `wsl --update`.
# 2.x brings systemd, mirrored networking (Windows 11), and `wsl --import
# --version 2` on Windows 10 19044+ (verify on Windows: the newest Store WSL
# that `wsl --update` installs on Windows 10 is at least this version).
WSL_MIN_VERSION=2.4.4
