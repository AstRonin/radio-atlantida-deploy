# Monthly restore drill of Radio Atlantida (deploy-init-plan.md D6 task 5):
# runs `radioctl restore-drill` as the Linux user radio. It restores the
# newest daily dump into the scratch database radio_restore_drill, checks
# it, and drops it; the production database is never touched. The result is
# in state.json (last_drill), the run log, and `update.bat status`.
# Installed by install/systemd/install-units.sh (setup-distro.sh, D4).
[Unit]
Description=Radio Atlantida monthly restore drill (radioctl restore-drill)
Wants=docker.service
After=docker.service
ConditionPathExists=/opt/radio-atlantida/deploy/runtime/applied.env

[Service]
Type=oneshot
User=radio
WorkingDirectory=/opt/radio-atlantida/deploy
Environment=RADIOCTL_LOCK_WAIT=3600
ExecStart=/opt/radio-atlantida/deploy/bin/radioctl restore-drill
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
